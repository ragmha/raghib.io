---
// Standalone layout for the Writing section only. Deliberately does not
// use BaseLayout/global.css/Header/Footer — those remain the rest of the
// site's normal design. This carries the monospace editorial theme ported
// from the closed static-generator prototype (PR #17), scoped to
// /writing and its posts.
import '../styles/writing.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Raghib Hasan',
  description = 'Independent writing on software, AI, systems, and the ideas shaping how technology is built and used.',
} = Astro.props

const pageTitle =
  title === 'Raghib Hasan' ? title : `${title} · Raghib Hasan`
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" href="/writing/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      // Set the theme before first paint so there is no flash.
      ;(function () {
        try {
          var saved = localStorage.getItem('theme')
          var dark = saved
            ? saved === 'dark'
            : window.matchMedia('(prefers-color-scheme: dark)').matches
          document.documentElement.dataset.theme = dark ? 'dark' : 'light'
        } catch {
          document.documentElement.dataset.theme = 'light'
        }
      })()
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="site-name" href="/">Raghib Hasan</a>
      <nav aria-label="Primary navigation">
        <a href="/">Home</a>
        <a href="/writing">Writing</a>
        <a href="https://github.com/ragmha" target="_blank" rel="noopener noreferrer">GitHub ↗</a>
        <button id="theme-toggle" type="button" aria-live="polite">
          <span data-theme-label>Dark</span>
        </button>
      </nav>
    </header>
    <div class="page">
      <slot />
    </div>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} Raghib Hasan</span>
      <span class="footer-links">
        <a href="https://github.com/ragmha" target="_blank" rel="noopener noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/ragmha/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a href="/writing/feed.xml">RSS</a>
      </span>
    </footer>
    <script src="../scripts/theme.js"></script>
  </body>
</html>
