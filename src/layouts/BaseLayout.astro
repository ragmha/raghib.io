---
import '../styles/global.css'

interface Props {
  title?: string
  description?: string
}

const {
  title = 'Raghib Hasan',
  description = 'Independent writing on software, AI, systems, and the ideas shaping how technology is built and used.',
} = Astro.props

const pageTitle =
  title === 'Raghib Hasan' ? title : `${title} · Raghib Hasan`
const analyticsToken = import.meta.env.PUBLIC_CF_ANALYTICS_TOKEN
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="alternate" type="application/rss+xml" href="/writing/feed.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>
