---
import WritingLayout from './WritingLayout.astro'
import SiteNav from '../components/SiteNav.astro'

interface Props {
  title: string
  description: string
  count: number
  itemLabel: string
  showHeading?: boolean
}

const { title, description, count, itemLabel, showHeading = true } = Astro.props
---

<WritingLayout title={title} description={description}>
  <div class="writing-index">
    <main id="main">
      <article class="prose">
        {showHeading ? (
          <header class="doc-head">
            <h1>{title}</h1>
            <p class="doc-meta">{count} {itemLabel}{count === 1 ? '' : 's'}</p>
          </header>
        ) : (
          <h1 class="visually-hidden">{title}</h1>
        )}
        <slot />
      </article>
    </main>
    <SiteNav />
  </div>
</WritingLayout>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }

  .writing-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr) var(--layout-nav-width);
    align-content: start;
    gap: var(--layout-gap);
    width: 100%;
    max-width: var(--layout-width);
    margin: 0 auto;
    padding: var(--layout-top) var(--layout-gutter) var(--layout-bottom);
  }

  .writing-index main {
    max-width: none;
    padding-top: var(--layout-content-offset);
  }

  @media (max-width: 600px) {
    .writing-index {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
