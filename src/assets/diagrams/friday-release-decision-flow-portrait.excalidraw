      "text": "An alert starts a decision.\nIt doesn't make one.",
      "fontSize": 30,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "decision-insight",
      "originalText": "An alert starts a decision.\nIt doesn't make one.",
      "autoResize": true,
      "lineHeight": 1.25
