---
import WritingLayout from '../../layouts/WritingLayout.astro'
import { formatDate } from '../../lib/posts'
import { seal } from '../../lib/talk-lock'
import { getTalks, outline, renderDeck, viewRequestUrl, type Talk } from '../../lib/talks'

export async function getStaticPaths() {
  return (await getTalks()).map((talk) => ({ params: { slug: talk.id }, props: { talk } }))
}

interface Props {
  talk: Talk
}

const { talk } = Astro.props
const { title, description, date, kind, locked } = talk.data
const deck = await renderDeck(talk)
const slides = deck.match(/<svg data-marpit-svg/g)?.length ?? 0
// Dev shows locked decks so they can be written; builds without a code ship only the request link.
const showDeck = !locked || import.meta.env.DEV
const code = process.env.TALK_CODE?.trim()
const sealed = !showDeck && code ? await seal(deck, code) : undefined
const downloads = [
  ['PDF', 'pdf'],
  ['PowerPoint', 'pptx'],
]
---

<WritingLayout title={title} description={description}>
  <div class="shell shell-solo">
    <main id="main" class="post-layout">
      <header class="post-head">
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/talks/">Talks</a> / <span>{kind}</span>
        </nav>
        <h1>{title}</h1>
        <p class="post-lede">{description}</p>
        <dl class="post-facts">
          <div><dt>Date:</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
          <div><dt>Slides:</dt><dd>{slides}</dd></div>
          {locked && <div><dt>Status:</dt><dd>In progress</dd></div>}
        </dl>
        {!locked && (
          <details class="talk-download">
            <summary>Download</summary>
            <ul role="list">
              {downloads.map(([label, extension]) => (
                <li><a href={`/talks/${talk.id}/${talk.id}.${extension}`} download>{label} (.{extension})</a></li>
              ))}
            </ul>
          </details>
        )}
      </header>

      {showDeck ? (
        <div class="talk-deck" set:html={deck} />
      ) : (
        <div class="talk-locked">
          <section aria-labelledby="talk-outline-title">
            <h2 id="talk-outline-title">What it covers</h2>
            <ol class="talk-outline">
              {outline(talk).map((title) => <li>{title}</li>)}
            </ol>
          </section>
          <section class="talk-ask" aria-labelledby="talk-ask-title">
            <h2 id="talk-ask-title">Want to see it?</h2>
            <p>The slides are still being written. Each request tells me which talk to finish first, and you will hear back when it is published.</p>
            <a class="talk-cta" href={viewRequestUrl(talk)}>Can I view this presentation?</a>
            <p class="talk-note">Opens a short GitHub issue. Requests are public.</p>
            {sealed && (
              <details class="talk-code">
                <summary>Have a view code?</summary>
                <form class="talk-unlock" data-sealed={sealed}>
                  <label for="talk-code">View code</label>
                  <div class="talk-unlock-row">
                    <input id="talk-code" name="code" type="password" autocomplete="off" required />
                    <button class="talk-button" type="submit">View</button>
                  </div>
                  <p class="talk-status" role="status"></p>
                </form>
              </details>
            )}
          </section>
        </div>
      )}
    </main>
  </div>
</WritingLayout>

<script>
  import { browser } from '@marp-team/marp-core/browser'
  import { open } from '../../lib/talk-lock'

  // Marp's polyfill keeps slide content scaled inside the SVG in WebKit.
  const deck = document.querySelector<HTMLElement>('.talk-deck')
  if (deck) browser(deck)

  const form = document.querySelector<HTMLFormElement>('.talk-unlock')
  form?.addEventListener('submit', async (event) => {
    event.preventDefault()
    const status = form.querySelector('.talk-status')!
    status.textContent = 'Checking the code…'
    try {
      const unlocked = document.createElement('div')
      unlocked.className = 'talk-deck'
      unlocked.tabIndex = -1
      unlocked.innerHTML = await open(form.dataset.sealed!, String(new FormData(form).get('code')))
      form.closest('.talk-locked')!.replaceWith(unlocked)
      browser(unlocked)
      unlocked.focus()
    } catch {
      status.textContent = 'That code did not work. Check it and try again.'
    }
  })
</script>

<style>
  /* Global: an unlocked deck is created in the browser without Astro's scope attribute. */
  :global(.talk-deck svg[data-marpit-svg]) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 1.25rem;
    border: 1px solid var(--rule);
  }

  :global(.talk-deck:focus) {
    outline: none;
  }

  .talk-download {
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }

  .talk-download ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .talk-download summary,
  .talk-button {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.8rem;
    text-decoration: none;
    cursor: pointer;
  }

  .talk-locked {
    display: grid;
    gap: 3.5rem;
    max-width: 40rem;
  }

  .talk-locked h2 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .talk-outline {
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: slide;
    border-top: 1px solid var(--rule);
  }

  .talk-outline li {
    display: grid;
    grid-template-columns: 3ch 1fr;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--rule);
    color: var(--ink);
    counter-increment: slide;
  }

  .talk-outline li::before {
    content: counter(slide);
    color: var(--ink-faint);
  }

  .talk-ask p {
    margin: 0;
    color: var(--ink-muted);
  }

  .talk-cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 1.5rem;
    padding: 0 1.25rem;
    border-radius: 0.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }

  .talk-cta:hover {
    background: var(--theme-highlight);
  }

  .talk-ask .talk-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .talk-code {
    margin-top: 2rem;
    font-size: 0.85rem;
  }

  .talk-code summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--ink-muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .talk-unlock {
    display: grid;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .talk-unlock-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .talk-unlock input {
    flex: 1 1 12rem;
    min-width: 0;
    min-height: 44px;
    padding: 0 0.75rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.25rem;
    background: var(--paper);
    color: var(--ink);
    font: inherit;
  }
</style>
