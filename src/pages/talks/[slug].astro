---
import WritingLayout from '../../layouts/WritingLayout.astro'
import { formatDate } from '../../lib/posts'
import { getTalks, renderCoverSlide, renderDeck, viewRequestUrl, type Talk } from '../../lib/talks'

export async function getStaticPaths() {
  return (await getTalks()).map((talk) => ({ params: { slug: talk.id }, props: { talk } }))
}

interface Props {
  talk: Talk
}

const { talk } = Astro.props
const { title, description, date, kind, locked } = talk.data
const deck = await renderDeck(talk)
const slides = deck.match(/<svg data-marpit-svg/g)?.length ?? 0
// Dev shows locked decks so they can be written; production shows the cover and request flow.
const showDeck = !locked || import.meta.env.DEV
// ponytail: a public cover works as the poster; the remaining slides stay locked.
const cover = locked && !showDeck ? await renderCoverSlide(talk) : undefined
const downloads = [
  ['PDF', 'pdf'],
  ['PowerPoint', 'pptx'],
]
---

<WritingLayout title={title} description={description}>
  <div class="shell shell-solo">
    <main id="main" class="post-layout">
      <header class="post-head">
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/talks/">Talks</a> / <span>{kind}</span>
        </nav>
        <h1>{title}</h1>
        <p class="post-lede">{description}</p>
        <dl class="post-facts">
          <div><dt>Format:</dt><dd>{kind}</dd></div>
          <div><dt>When:</dt><dd><time datetime={date.toISOString()}>{formatDate(date)}</time></dd></div>
          <div><dt>Slides:</dt><dd>{slides}</dd></div>
          {locked && <div><dt>Access:</dt><dd>On request</dd></div>}
        </dl>
        {!locked && (
          <details class="talk-download">
            <summary>Download</summary>
            <ul role="list">
              {downloads.map(([label, extension]) => (
                <li><a href={`/talks/${talk.id}/${talk.id}.${extension}`} download>{label} (.{extension})</a></li>
              ))}
            </ul>
          </details>
        )}
      </header>

      {cover && (
        <figure class="talk-cover">
          <div class="talk-cover-slide" role="img" aria-label={`Cover slide for ${title}`} set:html={cover} />
          <figcaption>Cover slide from the {slides}-slide presentation.</figcaption>
        </figure>
      )}

      {showDeck ? (
        <div class="talk-deck" set:html={deck} />
      ) : (
        <section class="talk-locked" aria-labelledby="talk-ask-title">
          <h2 id="talk-ask-title">Presentation preview</h2>
          <p>The first slide is public. The full presentation is shared on request.</p>
          <a class="talk-cta" href={`/talks/${talk.id}/${talk.id}-preview.pdf`}>View the slide (PDF)</a>
          <p class="talk-request">
            <a href={viewRequestUrl(talk)}>Can I view this presentation?</a>
          </p>
          <p class="talk-note">Opens a short GitHub issue. Requests are public.</p>
        </section>
      )}
    </main>
  </div>
</WritingLayout>

<script>
  import { browser } from '@marp-team/marp-core/browser'

  // Marp's polyfill keeps slide content scaled inside the SVG in WebKit.
  const deck = document.querySelector<HTMLElement>('.talk-deck')
  if (deck) browser(deck)
  const cover = document.querySelector<HTMLElement>('.talk-cover-slide')
  if (cover) browser(cover)
</script>

<style>
  /* Global: an unlocked deck is created in the browser without Astro's scope attribute. */
  :global(.talk-deck svg[data-marpit-svg]),
  :global(.talk-cover-slide svg[data-marpit-svg]) {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 0 1.25rem;
    border: 1px solid var(--rule);
  }

  .talk-cover {
    margin: 0 0 2.5rem;
  }

  .talk-cover figcaption {
    margin-top: 0.5rem;
    color: var(--ink-faint);
    font-size: 0.75rem;
  }

  .talk-download {
    margin-top: 1.5rem;
    font-size: 0.8rem;
  }

  .talk-download ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.25rem;
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }

  .talk-download summary {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.25rem;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.8rem;
    text-decoration: none;
    cursor: pointer;
  }

  .talk-locked {
    max-width: 40rem;
  }

  .talk-locked h2 {
    margin: 0 0 1rem;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
  }

  .talk-locked p {
    margin: 0;
    color: var(--ink-muted);
  }

  .talk-cta {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    margin-top: 1.5rem;
    padding: 0 1.25rem;
    border-radius: 0.25rem;
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
  }

  .talk-cta:hover {
    background: var(--theme-highlight);
  }

  .talk-locked .talk-note {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .talk-locked .talk-request {
    margin-top: 1.25rem;
  }

</style>
