---
import WritingLayout from '../../layouts/WritingLayout.astro'
import PostList from '../../components/PostList.astro'
import SiteNav from '../../components/SiteNav.astro'
import {
  formatDate,
  getPostCategory,
  getPostTags,
  getPostSlug,
  getPublishedPosts,
} from '../../lib/posts'

const posts = await getPublishedPosts()
---

<WritingLayout
  title="Writing"
  description="Essays and practical explorations of software, AI, systems, and responsible technology."
>
  <div class="writing-index">
    <main id="main">
      <article class="prose">
        <header class="doc-head">
          <h1>Writing</h1>
          <p class="doc-meta">
            {posts.length} {posts.length === 1 ? 'piece' : 'pieces'}
          </p>
        </header>

        <PostList
          posts={posts.map((post) => ({
            href: `/writing/${getPostSlug(post)}`,
            date: formatDate(post.data.date),
            title: post.data.title,
            description: post.data.description,
            category: getPostCategory(post),
            tags: getPostTags(post),
          }))}
        />
      </article>
    </main>
    <SiteNav />
  </div>
</WritingLayout>

<style>
  .writing-index {
    display: grid;
    grid-template-columns: minmax(0, 1fr) max-content;
    align-content: start;
    gap: 4rem;
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 2.5rem 1.25rem;
  }

  .writing-index main {
    max-width: none;
    padding-top: 1.4rem;
  }

  @media (max-width: 600px) {
    .writing-index {
      grid-template-columns: minmax(0, 1fr);
      gap: 2rem;
      padding-top: 2rem;
    }

    .writing-index main {
      padding-top: 0;
    }
  }
</style>
