---
import WritingLayout from '../../layouts/WritingLayout.astro'
import PostList from '../../components/PostList.astro'
import {
  formatDate,
  getPostCategory,
  getPostTags,
  getPostSlug,
  getPublishedPosts,
} from '../../lib/posts'

const posts = await getPublishedPosts()
---

<WritingLayout
  title="Writing"
  description="Essays and practical explorations of software, AI, systems, and responsible technology."
>
  <div class="shell shell-solo">
    <main id="main">
      <article class="prose">
        <header class="doc-head">
          <h1>Writing</h1>
          <p class="doc-meta">
            {posts.length} {posts.length === 1 ? 'piece' : 'pieces'}
          </p>
        </header>

        <PostList
          posts={posts.map((post) => ({
            href: `/writing/${getPostSlug(post)}`,
            date: formatDate(post.data.date),
            title: post.data.title,
            description: post.data.description,
            category: getPostCategory(post),
            tags: getPostTags(post),
          }))}
        />
      </article>
    </main>
  </div>
</WritingLayout>
