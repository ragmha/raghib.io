---
import ArchiveLayout from '../../layouts/ArchiveLayout.astro'
import PostList from '../../components/PostList.astro'
import {
  estimateReadingTime,
  formatDate,
  getPostCategory,
  getPostSlug,
  getPostTags,
  getTagLabel,
  getTaxonomySlug,
  getPublishedPosts,
  getTopics,
} from '../../lib/posts'

const posts = await getPublishedPosts()
const categories = [...new Set(posts.map(getPostCategory))].sort()
const topTopics = getTopics(posts).slice(0, 5)
---

<ArchiveLayout
  title="Writing"
  count={posts.length}
  itemLabel="piece"
  description="Essays and practical explorations of software, AI, systems, and responsible technology."
>
  {posts.length > 0 ? (
    <nav class="topic-strip" aria-label="Top topics">
      <span>Gone deep on:</span>
      {topTopics.map(({ slug, tag }) => (
        <a href={`/writing/tag/${slug}/`}>{getTagLabel(tag)}</a>
      ))}
      <a href="/writing/tag/">All topics →</a>
    </nav>
    <PostList
      posts={posts.map((post) => ({
        href: `/writing/${getPostSlug(post)}/`,
        date: formatDate(post.data.date),
        title: post.data.title,
        description: post.data.description,
        readingTime: estimateReadingTime(post.body),
        category: getPostCategory(post),
        tags: getPostTags(post),
      }))}
    />
    <section class="taxonomy-index" aria-label="Browse writing by topic">
      <h2>Browse by category</h2>
      <ul>
        {categories.map((category) => (
          <li>
            <a href={`/writing/category/${getTaxonomySlug(category)}/`}>{category}</a>
          </li>
        ))}
      </ul>
      <p><a href="/writing/tag/">Browse all topics →</a></p>
    </section>
  ) : (
    <p class="empty-writing">No posts published yet.</p>
  )}
</ArchiveLayout>

<style>
  .prose .empty-writing {
    color: var(--ink-muted);
    text-align: center;
  }

  .topic-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0 0 2rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .topic-strip span {
    color: var(--ink-faint);
  }

  .taxonomy-index ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem 1rem;
    list-style: none;
    margin: 0 0 1.5rem;
    padding: 0;
  }

  .taxonomy-index li {
    margin: 0;
  }
</style>
