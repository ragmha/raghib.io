---
import BaseLayout from '../../layouts/BaseLayout.astro'
import Header from '../../components/Header.astro'
import Footer from '../../components/Footer.astro'
import {
  estimateReadingTime,
  formatDate,
  getPostSlug,
  getPublishedPosts,
} from '../../lib/posts'

const posts = await getPublishedPosts()
---

<BaseLayout
  title="Writing"
  description="Essays and practical explorations of software, AI, systems, and responsible technology."
>
  <Header />
  <main>
    <header class="page-heading">
      <h1>Writing</h1>
      <p>
        Essays, experiments, and practical explorations of how technology
        changes the systems and organizations around it.
      </p>
    </header>

    <div class="post-list">
      {
        posts.map((post) => (
          <a class="post-row" href={`/writing/${getPostSlug(post)}`}>
            <div class="meta">
              <time datetime={post.data.date.toISOString()}>
                {formatDate(post.data.date)}
              </time>
              <span>{estimateReadingTime(post.body)}</span>
            </div>
            <h2>{post.data.title}</h2>
            <p>{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </main>
  <Footer />
</BaseLayout>
