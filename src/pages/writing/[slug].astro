---
import { getEntry, render } from 'astro:content'
import WritingLayout from '../../layouts/WritingLayout.astro'
import PartsNav from '../../components/PartsNav.astro'
import TagList from '../../components/TagList.astro'
import { SITE_NAME } from '../../lib/seo'
import {
  estimateReadingTime,
  formatDate,
  getPostCategory,
  getPostTags,
  getPostSlug,
  getVisiblePosts,
  type WritingEntry,
} from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getVisiblePosts({ includeDrafts: import.meta.env.DEV })
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }))
}

// Also renders Finnish posts for src/pages/fi/writing/[slug].astro.
interface Props {
  post: WritingEntry
}

const { post } = Astro.props
const fi = post.collection === 'writingFi'
const slug = getPostSlug(post)
const original = fi ? await getEntry('writing', post.id) : post
const translation = fi ? post : await getEntry('writingFi', post.id)
const visible = (entry?: WritingEntry) => Boolean(entry && (entry.data.published || import.meta.env.DEV))
const alternates = visible(original) && visible(translation)
  ? { en: `/writing/${slug}/`, fi: `/fi/writing/${slug}/` }
  : undefined
const t = fi
  ? { locale: 'fi-FI', minutes: 'MIN LUKUAIKA', all: '← Kaikki kirjoitukset', draft: 'Luonnoksen esikatselu — ei julkaistu.' }
  : { locale: 'en-GB', minutes: 'MIN READ', all: '← All writing', draft: 'Draft preview — not published. Review the account and conclusions before publishing.' }
// Labels come from the English original so both languages tag a post the same way.
const labelled = original ?? post
const { Content, headings } = await render(post)
const readingTime = estimateReadingTime(post.body, t.minutes)
---

<WritingLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  noindex={!post.data.published}
  lang={fi ? 'fi' : 'en'}
  alternates={alternates}
  article={{
    headline: post.data.title,
    date: post.data.date,
    image: post.data.socialImage,
  }}
>
  <div class="shell">
    <aside class="sidebar">
      <PartsNav headings={headings} title={post.data.title} readingTime={readingTime} />
    </aside>
    <main id="main">
      <article class="prose">
        <header class="doc-head">
          {!post.data.published && (
            <p class="draft-notice">{t.draft}</p>
          )}
          <h1 id="post-title">{post.data.title}</h1>
          <p class="doc-meta">
            <a href="/#about" rel="author">{SITE_NAME}</a> ·
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date, t.locale)}</time> · {readingTime}
            {alternates && (fi
              ? <> · <a href={alternates.en} hreflang="en" lang="en">English</a></>
              : <> · <a href={alternates.fi} hreflang="fi" lang="fi">Suomeksi</a></>)}
          </p>
          <TagList category={getPostCategory(labelled)} tags={getPostTags(labelled)} />
        </header>

        <Content />

        <hr class="rule-dotted" />
        <p class="doc-end"><a href="/writing/">{t.all}</a></p>
      </article>
    </main>
  </div>
</WritingLayout>

<style>
  .draft-notice {
    padding: 0.75rem;
    border: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
</style>
