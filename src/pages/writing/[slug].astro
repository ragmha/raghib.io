---
import { render, type CollectionEntry } from 'astro:content'
import WritingLayout from '../../layouts/WritingLayout.astro'
import PartsNav from '../../components/PartsNav.astro'
import TagList from '../../components/TagList.astro'
import {
  estimateReadingTime,
  formatDate,
  getPostCategory,
  getPostTags,
  getPostSlug,
  getPublishedPosts,
} from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'writing'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
---

<WritingLayout title={post.data.title} description={post.data.description}>
  <div class="shell">
    <aside class="sidebar">
      <PartsNav headings={headings} />
    </aside>
    <main id="main">
      <article class="prose">
        <header class="doc-head">
          <h1>{post.data.title}</h1>
          <p class="doc-meta">
            {formatDate(post.data.date)} · {estimateReadingTime(post.body)}
          </p>
          <TagList category={getPostCategory(post)} tags={getPostTags(post)} />
        </header>

        <Content />

        <hr class="rule-dotted" />
        <p class="doc-end"><a href="/writing">← All writing</a></p>
      </article>
    </main>
  </div>
</WritingLayout>
