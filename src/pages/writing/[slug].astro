---
import { render, type CollectionEntry } from 'astro:content'
import { Picture } from 'astro:assets'
import WritingLayout from '../../layouts/WritingLayout.astro'
import PartsNav from '../../components/PartsNav.astro'
import TagList from '../../components/TagList.astro'
import { SITE_NAME } from '../../lib/seo'
import {
  estimateReadingTime,
  formatDate,
  getPostCategory,
  getPostTags,
  getPostSlug,
  getVisiblePosts,
} from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getVisiblePosts({ includeDrafts: import.meta.env.DEV })
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'writing'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = estimateReadingTime(post.body)
---

<WritingLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  noindex={!post.data.published}
  article={{
    headline: post.data.title,
    date: post.data.date,
    image: post.data.socialImage,
  }}
>
  {post.data.cover && (
    <Picture
      class="cover"
      src={post.data.cover.src}
      alt={post.data.cover.alt}
      formats={['avif', 'webp']}
      layout="full-width"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="shell">
    <aside class="sidebar">
      <PartsNav headings={headings} title={post.data.title} readingTime={readingTime} />
    </aside>
    <main id="main">
      <article class="prose">
        <header class="doc-head">
          {!post.data.published && (
            <p class="draft-notice">Draft preview — not published. Review the account and conclusions before publishing.</p>
          )}
          <h1 id="post-title">{post.data.title}</h1>
          <p class="doc-meta">
            <a href="/#about" rel="author">{SITE_NAME}</a> ·
            <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time> · {readingTime}
          </p>
          <TagList category={getPostCategory(post)} tags={getPostTags(post)} />
        </header>

        <Content />

        <hr class="rule-dotted" />
        <p class="doc-end"><a href="/writing/">← All writing</a></p>
      </article>
    </main>
  </div>
</WritingLayout>

<style>
  /* Full-bleed hero; z-index keeps the fixed contents rail beneath it. */
  .cover {
    position: relative;
    z-index: 5;
    display: block;
    width: 100%;
    height: min(85svh, 75vw);
    object-fit: cover;
  }

  .draft-notice {
    padding: 0.75rem;
    border: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
</style>
