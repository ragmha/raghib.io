---
import { render, type CollectionEntry } from 'astro:content'
import { Picture } from 'astro:assets'
import WritingLayout from '../../layouts/WritingLayout.astro'
import PartsNav from '../../components/PartsNav.astro'
import AudioPlayer from '../../components/AudioPlayer.astro'
import DecisionHero from '../../components/DecisionHero.astro'
import FlowHero from '../../components/FlowHero.astro'
import RstackBox from '../../components/RstackBox.astro'
import {
  estimateReadingTime,
  getPostSlug,
  getVisiblePosts,
  getTagLabel,
  getTaxonomySlug,
} from '../../lib/posts'

export async function getStaticPaths() {
  const posts = await getVisiblePosts({ includeDrafts: import.meta.env.DEV })
  return posts.map((post) => ({
    params: { slug: getPostSlug(post) },
    props: { post },
  }))
}

interface Props {
  post: CollectionEntry<'writing'>
}

const { post } = Astro.props
const { Content, headings } = await render(post)
const readingTime = estimateReadingTime(post.body)
const minutes = parseInt(readingTime)
const topicHref = (topic: string) => `/writing/topic/${getTaxonomySlug(topic)}/`
const factDate = new Intl.DateTimeFormat('en-US', {
  month: 'short',
  day: 'numeric',
  year: 'numeric',
  timeZone: 'UTC',
})
const published = factDate.format(post.data.date)
const updated = post.data.updated && factDate.format(post.data.updated)
---

<WritingLayout
  title={post.data.seoTitle ?? post.data.title}
  description={post.data.description}
  noindex={!post.data.published}
  article={{
    headline: post.data.title,
    date: post.data.date,
    updated: post.data.updated,
    image: post.data.socialImage,
  }}
>
  {post.data.cover && (
    <Picture
      class="cover"
      src={post.data.cover.src}
      alt={post.data.cover.alt}
      formats={['avif', 'webp']}
      layout="full-width"
      loading="eager"
      fetchpriority="high"
    />
  )}
  <div class="shell shell-solo">
    <main id="main" class="post-layout">
      {post.data.hero && (post.data.hero === 'decision'
        ? <DecisionHero />
        : <FlowHero name={post.data.hero} />)}
      <header class="post-head">
        {!post.data.published && (
          <p class="draft-notice">Draft preview — not published. Review the account and conclusions before publishing.</p>
        )}
        <nav class="post-crumbs" aria-label="Breadcrumb">
          <a href="/writing/">Writing</a> / {post.data.published
            ? <a href={topicHref(post.data.topics[0])}>{post.data.topics[0]}</a>
            : <span>{post.data.topics[0]}</span>}
        </nav>
        <h1 id="post-title">{post.data.title}</h1>
        <p class="post-lede">{post.data.description}</p>
        {post.data.published && <AudioPlayer slug={getPostSlug(post)} />}
        <dl class="post-facts">
          <div><dt>Topics:</dt><dd>{post.data.topics.map((topic, i) => (
            <>{i > 0 && ', '}{post.data.published
              ? <a href={topicHref(topic)}>{topic}</a>
              : <span>{topic}</span>}</>
          ))}</dd></div>
          <div><dt>Published:</dt><dd><time datetime={post.data.date.toISOString()}>{published}</time></dd></div>
          {post.data.updated && (
            <div><dt>Last updated:</dt><dd><time datetime={post.data.updated.toISOString()}>{updated}</time></dd></div>
          )}
          <div><dt>Reading time:</dt><dd>{minutes} minute{minutes === 1 ? '' : 's'}</dd></div>
          {post.data.tags.length > 0 && (
            <div>
              <dt>Tags:</dt>
              <dd>
                {post.data.tags.map((tag, i) => (
                  <>{i > 0 && ', '}{post.data.published
                    ? <a href={`/writing/tag/${getTaxonomySlug(tag)}/`}>{getTagLabel(tag)}</a>
                    : <span>{getTagLabel(tag)}</span>}</>
                ))}
              </dd>
            </div>
          )}
        </dl>
      </header>

      <div class="post-body">
        <aside class="sidebar">
          <PartsNav headings={headings} />
        </aside>
        <article class="prose">
          <Content />
          {post.data.lab && (
            <p><a href={`/experiments/${post.data.lab}/`}>Explore the companion experiment →</a></p>
          )}
          {post.data.rstack && <RstackBox rstack={post.data.rstack} />}

          <hr class="rule-dotted" />
          <p class="doc-end"><a href="/writing/">← All writing</a></p>
        </article>
      </div>
    </main>
  </div>
</WritingLayout>

<style>
  /* Full-bleed hero; z-index keeps the fixed contents rail beneath it. */
  .cover {
    position: relative;
    z-index: 5;
    display: block;
    width: 100%;
    height: min(85svh, 75vw);
    object-fit: cover;
  }

  .draft-notice {
    padding: 0.75rem;
    border: 1px solid var(--rule-strong);
    color: var(--ink-muted);
    font-size: 0.85rem;
  }
</style>
