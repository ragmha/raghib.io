---
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro'
import { getPublishedPosts, getTagLabel, getTopics } from '../../../lib/posts'

const posts = await getPublishedPosts()
const topics = getTopics(posts)
---

<ArchiveLayout
  title="Topics"
  count={topics.length}
  itemLabel="topic"
  description="Every topic Raghib Hasan writes about, ordered by how often it comes up."
>
  <header class="post-head" slot="head">
    <nav class="post-crumbs" aria-label="Breadcrumb">
      <a href="/writing/">Writing</a> / <span aria-current="page">Topics</span>
    </nav>
    <h1>Topics</h1>
    <p class="post-lede">{topics.length} topics across {posts.length} articles. Most-written-about first.</p>
  </header>
  <ol class="topic-index">
    {topics.map(({ slug, tag, posts }, i) => (
      <li>
        <a href={`/writing/tag/${slug}/`}>
          <span class="topic-rank">{String(i + 1).padStart(2, '0')}</span>
          <span class="topic-name">{getTagLabel(tag)}</span>
          <span class="topic-count">{posts.length} article{posts.length === 1 ? '' : 's'} →</span>
        </a>
      </li>
    ))}
  </ol>
</ArchiveLayout>

<style>
  .post-head {
    border-bottom: 0;
    padding-bottom: 0;
  }

  :global(.prose) .topic-index {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--rule);
  }

  :global(.prose) .topic-index li {
    margin: 0;
    border-bottom: 1px solid var(--rule);
  }

  .topic-index a {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 1rem;
    padding: 1rem 0;
    color: var(--ink);
    text-decoration: none;
  }

  .topic-index a:hover .topic-name {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .topic-rank,
  .topic-count {
    font-size: 0.75rem;
    color: var(--ink-faint);
  }

  .topic-name {
    font-size: 1.15rem;
    font-weight: 700;
    text-transform: capitalize;
  }
</style>
