---
import ArchiveLayout from '../../../layouts/ArchiveLayout.astro'
import PostList from '../../../components/PostList.astro'
import {
  estimateReadingTime,
  formatDate,
  getPostSlug,
  getPostTags,
  getPublishedPosts,
  groupPosts,
} from '../../../lib/posts'

export async function getStaticPaths() {
  const posts = await getPublishedPosts()
  return groupPosts(posts, (post) => post.data.topics).map(({ name, slug, posts }) => ({
    params: { topic: slug },
    props: { label: name, posts },
  }))
}

const { label, posts } = Astro.props
const description = `Essays and practical guides on ${label}, from independent writing about software, AI, and how technology gets used.`
---

<ArchiveLayout
  title={`${label} writing`}
  count={posts.length}
  itemLabel="article"
  description={description}
>
  <header class="post-head" slot="head">
    <nav class="post-crumbs" aria-label="Breadcrumb">
      <a href="/writing/">Writing</a> / <a href="/writing/topic/">Topics</a> / <span aria-current="page">{label}</span>
    </nav>
    <h1>{label}</h1>
    <p class="post-lede">{posts.length} article{posts.length === 1 ? '' : 's'} on this topic, newest first.</p>
  </header>
  <PostList
    posts={posts.map((post) => ({
      href: `/writing/${getPostSlug(post)}/`,
      date: formatDate(post.data.date),
      title: post.data.title,
      description: post.data.description,
      readingTime: estimateReadingTime(post.body),
      topics: post.data.topics,
      tags: getPostTags(post),
    }))}
  />
  <p><a href="/writing/topic/">All topics</a></p>
</ArchiveLayout>

<style>
  /* PostList draws its own top rule. */
  .post-head {
    border-bottom: 0;
    padding-bottom: 0;
  }
</style>
