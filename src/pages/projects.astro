---
import ArchiveLayout from '../layouts/ArchiveLayout.astro'
import { projectSnapshot } from '../content/project-snapshot'
import { getVisibleProjectWriteups } from '../lib/project-writeups'
import { getProjectLinks } from '../lib/project-links'

const writeupLinks = new Map(
  (await getVisibleProjectWriteups())
    .filter(({ writeup }) => writeup.data.published)
    .map((entry) => [entry.project.name, entry]),
)
---

<ArchiveLayout
  title="Projects"
  count={projectSnapshot.length}
  itemLabel="project"
  showHeading={false}
  description="Open-source projects and technical demonstrations by Raghib Hasan."
>
  <ul class="project-archive" role="list">
    {
      projectSnapshot.map((project) => (
        <li class="project-entry">
          <span class="project-artwork" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor"
              stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" focusable="false">
              <rect x="4" y="3" width="16" height="18" rx="2" />
              <path d="M8 3v18M12 8h4M12 12h4" />
            </svg>
          </span>
          <div class="project-details">
            <h2 class="project-name">
              <a class="project-title-link" href={project.url}>{project.name}</a>
            </h2>
            {project.description && <p class="project-description">{project.description}</p>}
          </div>
          <div class="project-links">
            {getProjectLinks(project).map((link) => (
              <a class="project-extra" href={link.url}>{link.label} ↗</a>
            ))}
            {writeupLinks.has(project.name) && (
              <a class="project-extra" href={writeupLinks.get(project.name)?.href}>Writeup →</a>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</ArchiveLayout>

<style>
  .project-archive {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.8;
  }

  .project-entry {
    display: grid;
    grid-template-columns: 48px minmax(0, 1fr) fit-content(12rem);
    align-items: center;
    gap: 1rem;
    margin: 0;
    padding: 1.5rem 0.5rem;
    border-bottom: 1px solid var(--rule);
    overflow-wrap: anywhere;
  }

  .project-entry:is(:hover, :focus-within) {
    background: var(--paper-sunk);
  }

  .project-artwork {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 0.75rem;
    background: var(--paper-sunk);
    color: var(--ink-muted);
  }

  .project-details {
    min-width: 0;
  }

  .project-name {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: normal;
  }

  .project-details .project-description {
    margin: 0.35rem 0 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .project-title-link {
    border: 0;
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-title-link {
    font-weight: inherit;
    text-decoration: none;
  }

  .project-title-link:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.5rem;
    min-width: 0;
    max-width: 12rem;
  }

  .project-extra {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    max-width: 100%;
    padding: 0.3rem 0.65rem;
    border: 1px solid transparent;
    border-radius: 0.6rem;
    background: color-mix(in srgb, #159b86 12%, var(--paper));
    color: var(--ink);
    font-size: 0.75rem;
    line-height: 1.5;
    text-decoration: none;
  }

  .project-extra:is(:hover, :focus-visible) {
    background: color-mix(in srgb, #159b86 20%, var(--paper));
    border-color: var(--ink-muted);
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .project-entry {
      grid-template-columns: 48px minmax(0, 1fr);
      align-items: start;
      row-gap: 0.75rem;
    }

    .project-links {
      grid-column: 2;
      justify-content: flex-start;
      max-width: none;
    }
  }
</style>
