---
import ArchiveLayout from '../layouts/ArchiveLayout.astro'
import { projectSnapshot } from '../content/project-snapshot'
import { getVisibleProjectWriteups } from '../lib/project-writeups'

const writeupLinks = new Map(
  (await getVisibleProjectWriteups())
    .filter(({ writeup }) => writeup.data.published)
    .map((entry) => [entry.project.name, entry]),
)
---

<ArchiveLayout
  title="Projects"
  count={projectSnapshot.length}
  itemLabel="project"
  showHeading={false}
  description="Open-source projects and technical demonstrations by Raghib Hasan."
>
  <ul class="project-archive" role="list">
    {
      projectSnapshot.map((project) => (
        <li class="project-entry">
          <div class="project-details">
            <h2 class="project-name">
              <a class="project-title-link" href={project.url}>{project.name}</a>
            </h2>
            {project.description && <p class="project-description">{project.description}</p>}
            <div class="project-links">
                <a class="project-extra" href={project.url}>GitHub ↗</a>
                {project.homepage && <a class="project-extra" href={project.homepage}>Live ↗</a>}
                {writeupLinks.has(project.name) && (
                  <a class="project-extra" href={writeupLinks.get(project.name)?.href}>Writeup →</a>
                )}
            </div>
            {project.language && <span class="project-language">{project.language}</span>}
          </div>
        </li>
      ))
    }
  </ul>
</ArchiveLayout>

<style>
  .project-archive {
    display: grid;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.8;
  }

  .project-entry {
    margin: 0;
    padding: clamp(1.25rem, 3vw, 2.5rem);
    border: 1px solid var(--rule);
    border-radius: 0.75rem;
    background: var(--paper-sunk);
    overflow-wrap: anywhere;
  }

  .project-language {
    display: block;
    margin-top: 2rem;
    font-size: 0.75rem;
    color: var(--ink-muted);
  }

  .project-details {
    min-width: 0;
  }

  .project-name {
    margin: 0;
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.5;
    letter-spacing: normal;
  }

  .project-details .project-description {
    margin: 0.85rem 0 0;
    color: var(--ink-muted);
    font-size: 0.95rem;
    line-height: 1.8;
  }

  .project-title-link,
  .project-extra {
    border: 0;
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-title-link {
    font-weight: inherit;
  }

  .project-title-link:hover,
  .project-extra:hover {
    text-decoration-color: currentColor;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .project-extra {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--rule-strong);
    border-radius: 0.25rem;
    background: var(--paper);
    text-decoration: none;
    font-size: 0.8rem;
  }

  .project-extra:hover {
    border-color: var(--ink-muted);
    color: var(--ink);
    background: var(--paper-sunk);
  }
</style>
