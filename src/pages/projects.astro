---
import ArchiveLayout from '../layouts/ArchiveLayout.astro'
import { projectSnapshot } from '../content/project-snapshot'
import { getVisibleProjectWriteups } from '../lib/project-writeups'

const writeupLinks = new Map(
  (await getVisibleProjectWriteups())
    .filter(({ writeup }) => writeup.data.published)
    .map((entry) => [entry.project.name, entry]),
)
---

<ArchiveLayout
  title="Projects"
  count={projectSnapshot.length}
  itemLabel="project"
  description="Open-source projects and technical demonstrations by Raghib Hasan."
>
  <ul class="project-archive">
    {
      projectSnapshot.map((project) => (
        <li class="project-entry">
          <a class="project-title-link" href={project.url}>{project.name}</a>{project.description && <span class="project-description">: {project.description}</span>}
          {project.homepage && <a class="project-extra" href={project.homepage}>Live ↗</a>}
          {writeupLinks.has(project.name) && (
            <a class="project-extra" href={writeupLinks.get(project.name)?.href}>Writeup →</a>
          )}
        </li>
      ))
    }
  </ul>
</ArchiveLayout>

<style>
  .project-archive {
    margin: 0;
    padding-left: 1.5rem;
    list-style: disc;
    font-size: 1rem;
    line-height: 1.8;
  }

  .project-entry {
    margin: 0 0 1rem;
    padding-left: 0.4rem;
    overflow-wrap: anywhere;
  }

  .project-entry::marker {
    color: var(--ink-muted);
  }

  .project-description {
    color: var(--ink-muted);
  }

  .project-title-link,
  .project-extra {
    border: 0;
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-title-link {
    font-weight: 700;
  }

  .project-title-link:hover,
  .project-extra:hover {
    text-decoration-color: currentColor;
  }

  .project-extra {
    margin-left: 0.75rem;
    font-size: 0.85em;
  }
</style>
