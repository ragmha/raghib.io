---
import SiteLayout from '../layouts/SiteLayout.astro'
import { projectSnapshot } from '../content/project-snapshot'
import { getPublishedProjectWriteups } from '../lib/project-writeups'

const writeupLinks = new Map(
  (await getPublishedProjectWriteups()).map(({ project, href }) => [project.name, href]),
)
---

<SiteLayout
  title="Projects"
  heading="Projects"
  description="Open-source projects and technical demonstrations by Raghib Hasan."
>
  <div class="projects-intro">
    <p>
      Selected open-source work, technical demonstrations, and reference
      implementations.
    </p>
  </div>

  <div class="project-list">
    {
      projectSnapshot.map((project) => (
        <article class="project-row">
          <h2>{project.name}</h2>
          <p>{project.description}</p>
          <div class="meta">
            {project.language && <span>{project.language}</span>}
            <a href={project.url}>Source ↗</a>
            {project.homepage && <a href={project.homepage}>Live ↗</a>}
            {writeupLinks.has(project.name) && (
              <a href={writeupLinks.get(project.name)}>Writeup →</a>
            )}
          </div>
        </article>
      ))
    }
  </div>
</SiteLayout>

<style>
  .projects-intro {
    margin: 1rem 0 2.5rem;
  }
</style>
