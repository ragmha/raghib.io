---
import ArchiveLayout from '../layouts/ArchiveLayout.astro'
import { projectSnapshot } from '../content/project-snapshot'
import { getVisibleProjectWriteups } from '../lib/project-writeups'

const writeupLinks = new Map(
  (await getVisibleProjectWriteups())
    .filter(({ writeup }) => writeup.data.published)
    .map((entry) => [entry.project.name, entry]),
)
---

<ArchiveLayout
  title="Projects"
  count={projectSnapshot.length}
  itemLabel="project"
  showHeading={false}
  description="Open-source projects and technical demonstrations by Raghib Hasan."
>
  <ul class="project-archive" role="list">
    {
      projectSnapshot.map((project) => (
        <li class="project-entry">
          <span class="project-artwork" aria-hidden="true">
            {project.name.split(/[-_]+/).slice(0, 2).map((word) => word[0]).join('').toUpperCase()}
          </span>
          <div class="project-details">
            <h2 class="project-name">
              <a class="project-title-link" href={project.url}>{project.name}</a>
            </h2>
            {project.description && <p class="project-description">{project.description}</p>}
            {(project.homepage || writeupLinks.has(project.name)) && (
              <div class="project-links">
                {project.homepage && <a class="project-extra" href={project.homepage}>Live ↗</a>}
                {writeupLinks.has(project.name) && (
                  <a class="project-extra" href={writeupLinks.get(project.name)?.href}>Writeup →</a>
                )}
              </div>
            )}
          </div>
        </li>
      ))
    }
  </ul>
</ArchiveLayout>

<style>
  .project-archive {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    line-height: 1.8;
  }

  .project-entry {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr);
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    padding: 0.85rem 0.5rem;
    border-radius: 0.35rem;
    overflow-wrap: anywhere;
  }

  .project-entry:is(:hover, :focus-within) {
    background: var(--paper-sunk);
  }

  .project-artwork {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 0.25rem;
    background: var(--paper-sunk);
    color: var(--ink-muted);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .project-details {
    min-width: 0;
  }

  .project-name {
    margin: 0;
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.5;
    letter-spacing: normal;
  }

  .project-details .project-description {
    margin: 0.2rem 0 0;
    color: var(--ink-muted);
    font-size: 0.8rem;
    line-height: 1.5;
  }

  .project-title-link,
  .project-extra {
    border: 0;
    background: none;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--rule-strong);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .project-title-link {
    font-weight: inherit;
    text-decoration: none;
  }

  .project-title-link:hover,
  .project-extra:hover {
    text-decoration: underline;
    text-decoration-color: currentColor;
  }

  .project-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 0.75rem;
  }

  .project-extra {
    font-size: 0.8rem;
  }
</style>
