      padding: 0.45rem;
      border: 1px solid var(--calc-line);
      border-radius: 0;
      background: var(--theme-bg);
      color: inherit;
      font: inherit;
    }

    .token-inputs {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      margin-top: 1rem;
    }

    #manual-form select {
      appearance: none;
      padding-right: 2rem;
      background:
