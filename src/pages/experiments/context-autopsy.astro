      padding: 0.45rem 0.75rem;
      border: 1px solid var(--calc-line);
      border-radius: 0;
      background: var(--theme-text);
      color: var(--theme-bg);
      font: inherit;
      font-size: 0.85rem;
      text-decoration: none;
      cursor: pointer;
