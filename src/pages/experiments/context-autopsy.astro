    .compare-signatures {
      display: grid;
      gap: 0.6rem;
      margin-top: 1rem;
    }

    .compare-signatures :global(.compare-row) {
      display: grid;
      grid-template-columns: 4rem minmax(0, 1fr) 6.5rem;
      align-items: center;
      gap: 0.75rem;
    }

    .compare-signatures :global(.compare-label) {
      font-size: 0.8rem;
    }

    .calculator .compare-signatures :global(.token-mix) {
      margin-top: 0;
    }

    .compare-signatures :global(.token-total) {
      text-align: right;
    }

    #compare-table-wrap {
      margin-top: 0.75rem;
    }

    #compare-table-wrap :global(th),
    #compare-table-wrap :global(td) {
      padding-inline: 0.3rem;
      white-space: normal;
    }

    #compare-table-wrap :global(td:last-child) {
      white-space: nowrap;
    }

    .compare-signatures :global(.legend) {
      margin: 0.25rem 0 0;
      font-size: 0.75rem;
    }

    @media (max-width: 36rem) {
      .compare-signatures :global(.compare-row) {
        grid-template-columns: 3.25rem minmax(0, 1fr);
      }

      .compare-signatures :global(.compare-row .token-total) {
        grid-column: 2;
        text-align: left;
      }
    }

    .actions .quiet {
      background: transparent;
      color: inherit;
    }

    .actions button:disabled {
      cursor: wait;
      opacity: 0.6;
    }

    .status,
    .table-note,
    .coverage {
      color: var(--calc-muted);
      font-size: 0.82rem;
    }

    .export-help {
      margin-top: 1rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--calc-line);
