---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { modelPrices, pricingDate } from '../../lib/model-pricing'
import { analyzeUsage, demoEvents, findings, parseUsage } from '../../lib/agent-usage'

const sample = analyzeUsage([parseUsage(demoEvents)])
const sampleFindings = findings(sample)
const sampleCoverage = `Illustrative sample · ${sample.sources.join(' + ')} · ${sample.coverage}`
const count = (total: { value: number | null; missing: number }) =>
  total.value === null ? '—' : `${new Intl.NumberFormat('en-US').format(total.value)}${total.missing ? '+' : ''}`
const sampleFacts = [
  ['Sessions', String(sample.sessions)],
  ['Model calls', count(sample.totals.requests)],
  ['Input from cache', sample.totals.input.value && sample.totals.read.value !== null
    ? new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 }).format(sample.totals.read.value / sample.totals.input.value)
    : '—'],
  ['Peak context per call', new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 })
    .format(Math.max(0, ...sample.calls.map((call) => call.input ?? 0)))],
  ['Input tokens', count(sample.totals.input)],
  ['Output tokens', count(sample.totals.output)],
]

const description =
  'See how Claude Code, Codex, and GitHub Copilot sessions use the model: context per call, cache reuse, output, tools, and cross-model cost. Runs in your browser.'
const home = new URL('/', Astro.site ?? Astro.url)
const appJsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@graph': [{
    '@type': 'WebApplication',
    name: 'What’s Under the Prompt?',
    url: new URL(Astro.url.pathname, home).href,
    description,
    applicationCategory: 'DeveloperApplication',
    operatingSystem: 'Any (runs in a web browser)',
    browserRequirements: 'Requires JavaScript',
    isAccessibleForFree: true,
    offers: { '@type': 'Offer', price: 0, priceCurrency: 'USD' },
    author: { '@id': `${home.href}#author` },
    isPartOf: { '@id': `${home.href}#website` },
  }],
}).replace(/</g, '\\u003c')
---

<SiteLayout
  title="What’s Under the Prompt? Agent Token Analyzer"
  heading="What’s Under the Prompt?"
  description={description}
>
  <script is:inline type="application/ld+json" set:html={appJsonLd} />
  <div class="calculator">
    <p class="intro">
      Explore a sample session below, or add your own to inspect context, cache reuse, model
      output, and tool activity.
    </p>

    <noscript>
      <p class="notice">
        Enable JavaScript to view the sample report and use the calculator.
      </p>
    </noscript>

    <section id="results" class="results" aria-labelledby="results-heading" tabindex="-1">
      <h2 id="results-heading">What happened under the prompt</h2>
      <p id="coverage" class="coverage">{sampleCoverage}</p>
      <div id="summary" class="summary">
        {sampleFacts.map(([label, value]) => <div><span>{label}</span><strong>{value}</strong></div>)}
      </div>

      <section id="findings-panel" class="panel" aria-labelledby="findings-heading">
        <h3 id="findings-heading">Findings</h3>
        <ul id="findings-list" class="findings">{sampleFindings.map((note) => <li>{note}</li>)}</ul>
      </section>

      <section id="timeline-panel" class="panel" aria-labelledby="timeline-heading" hidden>
        <div class="chart-head">
          <h3 id="timeline-heading">Context, call by call</h3>
          <fieldset class="toggle">
            <legend class="visually-hidden">Chart view</legend>
            <label><input type="radio" name="timeline-mode" value="call" checked /> Per call</label>
            <label><input type="radio" name="timeline-mode" value="total" /> Running total</label>
          </fieldset>
        </div>
        <p class="table-note">Hover, tap, or focus the chart and use arrow keys to inspect each call.</p>
        <div class="chart-wrap">
          <svg id="timeline" class="context-chart" viewBox="0 0 720 280" tabindex="0" role="img"></svg>
          <div id="timeline-tip" class="chart-tip" role="status" aria-live="polite" hidden></div>
        </div>
        <ul class="legend">
          <li><span class="swatch read"></span>Cached input</li>
          <li><span class="swatch fresh"></span>Fresh input and cache writes</li>
          <li><span class="swatch output"></span>Output</li>
        </ul>
      </section>

      <section class="panel" aria-labelledby="mix-heading">
        <h3 id="mix-heading">Where the tokens went</h3>
        <div id="token-mix" class="token-mix" role="img"></div>
        <ul id="token-legend" class="legend"></ul>
      </section>

      <section id="recorded-models" class="panel" aria-labelledby="recorded-heading" hidden>
        <h3 id="recorded-heading">How each model was used</h3>
        <div class="table-wrap">
          <table>
            <thead><tr><th scope="col">Model</th><th scope="col">Calls</th><th scope="col">Input tokens</th><th scope="col">Cached</th><th scope="col">Output tokens</th></tr></thead>
            <tbody id="recorded-body"></tbody>
          </table>
        </div>
      </section>

      <section id="tool-activity" class="panel" aria-labelledby="tools-heading" hidden>
        <h3 id="tools-heading">Tools the agent reached for</h3>
        <ol id="tools-chart" class="bar-chart"></ol>
        <p id="failure-count" class="table-note"></p>
      </section>

      <section class="panel" aria-labelledby="comparison-heading">
        <h3 id="comparison-heading">What if a different model did the same work?</h3>
        <p class="table-note">
          API price estimates at provider-published rates, last checked
          <time datetime={pricingDate}>{pricingDate}</time>. Highlighted models were recorded
          in the session; ranges reflect known cache TTL, long-context, or time-based rate tiers.
          API prices are not agent subscriptions or plan allowances.
        </p>
        <ol id="cost-chart" class="bar-chart"></ol>
        <div class="table-wrap">
          <table class="sortable">
            <thead>
              <tr>
                <th scope="col"><button type="button" data-sort="model" aria-label="Sort by model">Model</button></th>
                <th scope="col">Provider</th>
                <th scope="col">Context / rate notes</th>
                <th scope="col"><button type="button" data-sort="benchmark" aria-label="Sort by one million input plus one million output tokens">1M in + 1M out</button></th>
                <th scope="col" aria-sort="ascending"><button type="button" data-sort="cost" aria-label="Sort by workload cost">Workload cost</button></th>
              </tr>
            </thead>
            <tbody id="comparison-sort-body"></tbody>
          </table>
        </div>
        <details class="rate-table">
          <summary>Show exact estimates and token rates</summary>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th scope="col">Model</th>
                  <th scope="col">Estimated total</th>
                  <th scope="col">Input</th>
                  <th scope="col">Cached input</th>
                  <th scope="col">5-minute write</th>
                  <th scope="col">1-hour write</th>
                  <th scope="col">Output</th>
                </tr>
              </thead>
              <tbody id="comparison-body"></tbody>
            </table>
          </div>
          <p class="table-note">
            Rates are USD per 1 million tokens. A “+” on a token total means some records
            did not report that category. Cache writes without a reported TTL are shown as
            a cost range when the provider has different TTL rates. Prices exclude batch
            discounts, regional uplifts, taxes, storage fees, and tool fees unless noted.
            Reasoning tokens are included in output.
          </p>
        </details>
      </section>

      <section id="warnings-panel" class="panel warnings" aria-labelledby="warnings-heading" hidden>
        <h3 id="warnings-heading">Coverage notes</h3>
        <ul id="warnings-list"></ul>
      </section>
    </section>

    <section class="panel" aria-labelledby="session-heading">
      <h2 id="session-heading">Try your own session</h2>
      <p>Drop JSON or JSONL logs from Copilot, Codex, Claude Code, or OpenTelemetry.</p>
      <details class="sources-help">
        <summary>Supported files and paths</summary>
        <dl class="sources">
          <div><dt>GitHub Copilot CLI</dt><dd><code>~/.copilot/session-state/&lt;session&gt;/events.jsonl</code></dd></div>
          <div><dt>Codex CLI</dt><dd><code>~/.codex/sessions/YYYY/MM/DD/rollout-*.jsonl</code></dd></div>
          <div><dt>Claude Code</dt><dd><code>~/.claude/projects/&lt;project&gt;/&lt;session&gt;.jsonl</code></dd></div>
          <div><dt>OpenTelemetry</dt><dd>GenAI chat and tool spans as OTLP JSON</dd></div>
        </dl>
      </details>
      <label class="dropzone" for="session-files">
        <span><strong>Choose or drop logs</strong></span>
        <span>20 files max · 20 MiB each · 50 MiB total</span>
        <input id="session-files" type="file" accept=".json,.jsonl,application/json" multiple />
      </label>
      <div class="actions">
        <button id="demo-button" type="button">Reload sample report</button>
        <button id="clear-button" type="button" class="quiet" hidden>Clear results</button>
      </div>
      <p id="status" class="status" role="status" aria-live="polite">Sample report loaded. Add a session below to replace it.</p>

      <details class="export-help">
        <summary>Having trouble finding the session file?</summary>
        <p>
          These folders are hidden. On macOS, press <kbd>⌘</kbd><kbd>⇧</kbd><kbd>G</kbd> in
          the file picker and paste the folder path; on Windows, paste the path with
          <code>%USERPROFILE%</code> in place of <code>~</code>. Codex and Claude Code
          files can be dropped directly. Copilot names each session folder by ID, so these
          helpers list IDs and dates, then copy the chosen raw file locally.
        </p>
        <div class="actions">
          <a href="/copilot-export.sh" download>Download Copilot Bash helper</a>
          <a href="/copilot-export.ps1" download>Download Copilot PowerShell helper</a>
        </div>
        <pre><code>bash copilot-export.sh --list
bash copilot-export.sh --session SESSION_ID --output copilot-events.jsonl</code></pre>
        <pre><code>.\copilot-export.ps1 -List
.\copilot-export.ps1 -Session SESSION_ID -Output copilot-events.jsonl</code></pre>
        <p>
          Review raw logs before sharing; they may contain private conversation or tool data.
        </p>
      </details>
    </section>

    <section class="panel" aria-labelledby="manual-heading">
      <h2 id="manual-heading">Enter counts instead</h2>
      <p>No session log? Enter token counts to compare model prices.</p>
      <form id="manual-form">
        <label>
          Model used
          <select id="manual-model">
            {modelPrices.map((price) => <option value={price.id}>{price.name}</option>)}
          </select>
        </label>
        <div class="token-inputs">
          <label>
            Uncached input
            <input id="uncached-input" inputmode="decimal" value="0" autocomplete="off" />
          </label>
          <label>
            Cached input reads
            <input id="cache-read" inputmode="decimal" value="0" autocomplete="off" />
          </label>
          <label>
            Cache writes (TTL unknown)
            <input id="cache-write" inputmode="decimal" value="0" autocomplete="off" />
          </label>
          <label>
            5-minute cache writes
            <input id="cache-write-5m" inputmode="decimal" value="0" autocomplete="off" />
          </label>
          <label>
            1-hour cache writes
            <input id="cache-write-1h" inputmode="decimal" value="0" autocomplete="off" />
          </label>
          <label>
            Output + reasoning
            <input id="output-tokens" inputmode="decimal" value="0" autocomplete="off" />
          </label>
        </div>
        <p id="manual-error" class="error" role="alert" hidden></p>
        <div class="actions">
          <button id="manual-submit" type="submit">Compare model costs</button>
        </div>
      </form>
    </section>

  </div>

  <script>
    import { findModelPrice } from '../../lib/model-pricing'
    import {
      analyzeUsage,
      compareModels,
      demoEvents,
      estimateCost,
      findings,
      manualUsage,
      parseUsage,
      parseTokenInput,
      type Analysis,
      type Usage,
      type UsageTotals,
    } from '../../lib/agent-usage'
    import type { WorkerRequest, WorkerResponse } from '../../lib/agent-usage.worker'

    const worker = new Worker(new URL('../../lib/agent-usage.worker.ts', import.meta.url), { type: 'module' })
    const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T
    const fileInput = byId<HTMLInputElement>('session-files')
    const status = byId<HTMLParagraphElement>('status')
    const results = byId<HTMLElement>('results')
    const clearButton = byId<HTMLButtonElement>('clear-button')
    const numberFormat = new Intl.NumberFormat()
    const compactFormat = new Intl.NumberFormat('en-US', { notation: 'compact', maximumFractionDigits: 1 })
    const percentFormat = new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 })
    const timeFormat = new Intl.DateTimeFormat(undefined, { dateStyle: 'medium', timeStyle: 'short' })
    const currencyFormat = new Intl.NumberFormat('en-US', {
      style: 'currency', currency: 'USD', maximumSignificantDigits: 4,
    })
    let lastAnalysis: Analysis | null = null
    let pricingWorkload: Usage[] = []
    let sortBy: 'model' | 'benchmark' | 'cost' = 'cost'
    let sortDirection: 1 | -1 = 1

    function element<K extends keyof HTMLElementTagNameMap>(tag: K, className = '', text = '') {
      const node = document.createElement(tag)
      if (className) node.className = className
      if (text) node.textContent = text
      return node
    }

    function cell(tag: 'td' | 'th', text: string, scope?: 'row') {
      const node = element(tag, '', text)
      if (scope) node.scope = scope
      return node
    }

    function tokenTotal(total: UsageTotals[keyof UsageTotals]) {
      return total.value === null ? '—' : `${numberFormat.format(total.value)}${total.missing ? '+' : ''}`
    }

    function estimatedCost(low: number | null, high: number | null) {
      if (low === null || high === null) return '—'
      return Math.abs(high - low) < 0.000001
        ? currencyFormat.format(low)
        : `${currencyFormat.format(low)}–${currencyFormat.format(high)}`
    }

    type Bar = { label: string; value: number; extra?: number; text: string; highlight?: boolean }
    function renderBars(list: HTMLElement, bars: Bar[]) {
      list.replaceChildren()
      const max = Math.max(0, ...bars.map((bar) => bar.value + (bar.extra ?? 0)))
      for (const bar of bars) {
        const item = element('li', bar.highlight ? 'highlight' : '')
        const track = element('span', 'bar-track')
        const fill = element('span', 'bar-fill')
        fill.style.width = `${max ? (bar.value / max) * 100 : 0}%`
        track.append(fill)
        if (bar.extra) {
          const range = element('span', 'bar-range')
          range.style.width = `${(bar.extra / max) * 100}%`
          track.append(range)
        }
        item.append(element('span', 'bar-label', bar.label), track, element('span', 'bar-value', bar.text))
        list.append(item)
      }
    }

    function renderTokenMix(analysis: Analysis) {
      const value = (field: 'input' | 'output' | 'read' | 'write') => analysis.totals[field].value ?? 0
      const read = value('read')
      const write = value('write') + (analysis.totals.cacheWrite5m.value ?? 0) +
        (analysis.totals.cacheWrite1h.value ?? 0)
      const parts = [
        { name: 'Fresh input', className: 'fresh', tokens: Math.max(0, value('input') - read - write) },
        { name: 'Cached input', className: 'read', tokens: read },
        { name: 'Cache writes', className: 'write', tokens: write },
        { name: 'Output', className: 'output', tokens: value('output') },
      ]
      const total = parts.reduce((sum, part) => sum + part.tokens, 0)
      const mix = byId('token-mix')
      const legend = byId('token-legend')
      mix.replaceChildren()
      legend.replaceChildren()
      mix.setAttribute('aria-label', parts.map((part) =>
        `${part.name}: ${numberFormat.format(part.tokens)} tokens`).join(', '))
      for (const part of parts) {
        const share = total ? part.tokens / total : 0
        if (share) {
          const segment = element('span', `segment ${part.className}`)
          segment.style.flexGrow = String(part.tokens)
          segment.title = `${part.name}: ${numberFormat.format(part.tokens)}`
          mix.append(segment)
        }
        const item = element('li')
        item.append(element('span', `swatch ${part.className}`),
          `${part.name} · ${compactFormat.format(part.tokens)} · ${percentFormat.format(share)}`)
        legend.append(item)
      }
    }

    type Point = { label: string; at: number | null; model: string; read: number; fresh: number; output: number }
    let timelinePoints: Point[] = []
    let timelineIndex = -1
    let timelineMode: 'call' | 'total' = 'call'
    const svgNS = 'http://www.w3.org/2000/svg'
    const chart = { width: 720, height: 280, left: 56, right: 12, top: 12, bottom: 32 }

    function svg<K extends keyof SVGElementTagNameMap>(tag: K, attributes: Record<string, string | number>, text = '') {
      const node = document.createElementNS(svgNS, tag)
      for (const [name, value] of Object.entries(attributes)) node.setAttribute(name, String(value))
      if (text) node.textContent = text
      return node
    }

    function chartSeries() {
      if (timelineMode === 'call') return timelinePoints
      let read = 0, fresh = 0, output = 0
      return timelinePoints.map((point) => ({
        ...point, read: read += point.read, fresh: fresh += point.fresh, output: output += point.output,
      }))
    }

    function renderTimeline(calls: Usage[]) {
      const panel = byId('timeline-panel')
      const visible = calls.filter((call) => call.input !== null || call.output !== null)
      panel.hidden = visible.length < 2
      timelinePoints = []
      timelineIndex = -1
      if (panel.hidden) return
      // ponytail: bucket long sessions so the chart stays readable without a charting library.
      const size = Math.ceil(visible.length / 160)
      for (let index = 0; index < visible.length; index += size) {
        const group = visible.slice(index, index + size)
        const models = [...new Set(group.map((call) => call.model))]
        timelinePoints.push({
          label: group.length === 1 ? `Call ${index + 1}` : `Calls ${index + 1}–${index + group.length}`,
          at: group.find((call) => call.at !== null)?.at ?? null,
          model: models.length === 1 ? models[0] : `${models.length} models`,
          read: group.reduce((sum, call) => sum + (call.read ?? 0), 0),
          fresh: group.reduce((sum, call) => sum + Math.max(0, (call.input ?? 0) - (call.read ?? 0)), 0),
          output: group.reduce((sum, call) => sum + (call.output ?? 0), 0),
        })
      }
      drawTimeline()
    }

    function drawTimeline() {
      const root = byId('timeline') as unknown as SVGSVGElement
      root.replaceChildren()
      const points = chartSeries()
      if (!points.length) return
      chart.width = Math.max(320, Math.round(root.clientWidth || 720))
      chart.height = Math.max(160, Math.round(root.clientHeight || 280))
      root.setAttribute('viewBox', `0 0 ${chart.width} ${chart.height}`)
      const { width, height, left, right, top, bottom } = chart
      const plotWidth = width - left - right
      const plotHeight = height - top - bottom
      const max = Math.max(1, ...points.map((point) => point.read + point.fresh + point.output))
      const x = (index: number) => left + (points.length === 1 ? plotWidth / 2 : (index / (points.length - 1)) * plotWidth)
      const y = (value: number) => top + plotHeight - (value / max) * plotHeight

      for (let tick = 0; tick <= 4; tick++) {
        const value = (max / 4) * tick
        root.append(
          svg('line', { x1: left, x2: width - right, y1: y(value), y2: y(value), class: 'grid' }),
          svg('text', { x: left - 8, y: y(value) + 4, 'text-anchor': 'end', class: 'axis' }, compactFormat.format(value)),
        )
      }
      const firstTime = points.find((point) => point.at !== null)?.at
      const lastTime = points.findLast((point) => point.at !== null)?.at
      root.append(
        svg('text', { x: left, y: height - 8, class: 'axis' }, firstTime ? timeFormat.format(firstTime) : 'First call'),
        svg('text', { x: width - right, y: height - 8, 'text-anchor': 'end', class: 'axis' }, lastTime ? timeFormat.format(lastTime) : 'Last call'),
      )

      const layers = [
        { className: 'read', value: (point: Point) => point.read },
        { className: 'fresh', value: (point: Point) => point.read + point.fresh },
        { className: 'output', value: (point: Point) => point.read + point.fresh + point.output },
      ]
      let lower = points.map(() => 0)
      for (const layer of layers) {
        const upper = points.map(layer.value)
        const edge = upper.map((value, index) => `${x(index)},${y(value)}`)
        const base = lower.map((value, index) => `${x(index)},${y(value)}`).reverse()
        root.append(svg('polygon', { points: [...edge, ...base].join(' '), class: `area ${layer.className}` }))
        root.append(svg('polyline', { points: edge.join(' '), class: `edge ${layer.className}` }))
        lower = upper
      }

      const guide = svg('g', { class: 'guide' })
      root.append(guide)
      const hit = svg('rect', { x: left, y: top, width: plotWidth, height: plotHeight, class: 'hit' })
      root.append(hit)
      const peak = points.reduce((best, point, index) =>
        point.read + point.fresh > points[best].read + points[best].fresh ? index : best, 0)
      root.setAttribute('aria-label', `${timelineMode === 'call' ? 'Tokens per call' : 'Running token total'} across ${points.length} points; peak ${compactFormat.format(max)} tokens at ${points[peak].label}.`)

      const select = (index: number) => {
        timelineIndex = Math.max(0, Math.min(points.length - 1, index))
        const point = points[timelineIndex]
        const total = point.read + point.fresh + point.output
        guide.replaceChildren(
          svg('line', { x1: x(timelineIndex), x2: x(timelineIndex), y1: top, y2: top + plotHeight }),
          svg('circle', { cx: x(timelineIndex), cy: y(total), r: 4 }),
        )
        const tip = byId('timeline-tip')
        tip.hidden = false
        tip.replaceChildren(
          element('strong', '', `${point.label}${timelineMode === 'total' ? ' (running total)' : ''}`),
          element('span', '', [point.model, point.at ? timeFormat.format(point.at) : ''].filter(Boolean).join(' · ')),
          element('span', '', `Cached input ${numberFormat.format(point.read)}`),
          element('span', '', `Fresh input ${numberFormat.format(point.fresh)}`),
          element('span', '', `Output ${numberFormat.format(point.output)}`),
          element('span', '', point.read + point.fresh
            ? `${percentFormat.format(point.read / (point.read + point.fresh))} of input from cache` : ''),
        )
        const share = (x(timelineIndex) - left) / plotWidth
        tip.style.left = `${Math.min(Math.max(share * 100, 0), 100)}%`
        tip.style.transform = `translateX(${share > 0.6 ? '-100%' : '0'})`
      }
      const fromPointer = (event: PointerEvent) => {
        const box = root.getBoundingClientRect()
        const position = ((event.clientX - box.left) / box.width) * width
        select(Math.round(((position - left) / plotWidth) * (points.length - 1)))
      }
      root.onpointermove = fromPointer
      root.onpointerdown = fromPointer
      root.onpointerleave = () => { if (document.activeElement !== root) hideTip() }
      root.onfocus = () => select(timelineIndex < 0 ? peak : timelineIndex)
      root.onblur = hideTip
      root.onkeydown = (event) => {
        const step = { ArrowRight: 1, ArrowLeft: -1, End: points.length, Home: -points.length }[event.key]
        if (step === undefined) return
        event.preventDefault()
        select((timelineIndex < 0 ? peak : timelineIndex) + step)
      }
      if (timelineIndex >= 0) select(timelineIndex)

      function hideTip() {
        guide.replaceChildren()
        byId('timeline-tip').hidden = true
      }
    }

    function renderComparison(analysis: Analysis, workload: Usage[]) {
      pricingWorkload = workload
      const comparison = compareModels(workload)
      const recorded = analysis.models.flatMap((model) => {
        const price = findModelPrice(model.model)
        return price ? [price.id] : []
      })
      const rows = comparison.map(({ price, estimate }) => {
        const benchmark = estimateCost([manualUsage(price.id, 1_000_000, 0, 0, 1_000_000)], price)
        return { price, estimate, benchmark }
      })
      rows.sort((a, b) => {
        const direction = sortDirection
        if (sortBy === 'model') return direction * a.price.name.localeCompare(b.price.name)
        const aValue = sortBy === 'benchmark' ? a.benchmark.low : a.estimate.low
        const bValue = sortBy === 'benchmark' ? b.benchmark.low : b.estimate.low
        return direction * ((aValue ?? Infinity) - (bValue ?? Infinity))
      })

      renderBars(byId('cost-chart'), [...rows].filter(({ estimate }) => estimate.low !== null)
        .sort((a, b) => (a.estimate.low ?? Infinity) - (b.estimate.low ?? Infinity))
        .map(({ price, estimate }) => ({
          label: price.name,
          value: estimate.low!,
          extra: (estimate.high ?? estimate.low!) - estimate.low!,
          text: estimatedCost(estimate.low, estimate.high),
          highlight: recorded.includes(price.id),
        })))

      const sortableBody = byId<HTMLTableSectionElement>('comparison-sort-body')
      sortableBody.replaceChildren()
      for (const { price, estimate, benchmark } of rows) {
        const row = element('tr', recorded.includes(price.id) ? 'recorded' : '')
        row.append(cell('th', price.name, 'row'))
        const provider = cell('td', '')
        const providerLink = element('a', '', price.provider)
        providerLink.href = price.source
        providerLink.rel = 'noreferrer'
        provider.append(providerLink)
        row.append(provider)
        row.append(cell('td', [price.context, price.note].filter(Boolean).join(' · ')))
        row.append(cell('td', estimatedCost(benchmark.low, benchmark.high)))
        row.append(cell('td', estimatedCost(estimate.low, estimate.high)))
        sortableBody.append(row)
      }

      const rateBody = byId<HTMLTableSectionElement>('comparison-body')
      rateBody.replaceChildren()
      for (const { price, estimate } of comparison) {
        const row = element('tr', recorded.includes(price.id) ? 'recorded' : '')
        const write5m = price.rates[2] || price.rates[0]
        const write1h = price.write1h ?? write5m
        row.append(
          cell('th', price.name, 'row'),
          cell('td', estimatedCost(estimate.low, estimate.high)),
          cell('td', currencyFormat.format(price.rates[0])),
          cell('td', currencyFormat.format(price.rates[1])),
          cell('td', currencyFormat.format(write5m)),
          cell('td', currencyFormat.format(write1h)),
          cell('td', currencyFormat.format(price.rates[3])),
        )
        rateBody.append(row)
      }
    }

    function showAnalysis(analysis: Analysis, isExample = false) {
      lastAnalysis = analysis
      results.hidden = false
      clearButton.hidden = false
      const coverage = analysis.sources.length
        ? `${analysis.sources.join(' + ')} · ${analysis.coverage}`
        : analysis.coverage
      byId('coverage').textContent = isExample ? `Illustrative sample · ${coverage}` : coverage

      const summary = byId<HTMLDivElement>('summary')
      summary.replaceChildren()
      const recordedCost = analysis.models.length && analysis.models.every((model) => findModelPrice(model.model))
        ? estimatedCost(...analysis.models.reduce<[number | null, number | null]>(([low, high], model) => {
          const estimate = compareModels(analysis.workload.filter((record) => record.model === model.model))
            .find(({ price }) => price.id === findModelPrice(model.model)?.id)?.estimate
          return estimate?.low == null || low === null || high === null
            ? [null, null] : [low + estimate.low, high + (estimate.high ?? estimate.low)]
        }, [0, 0]))
        : '—'
      const cacheShare = analysis.totals.input.value && analysis.totals.read.value !== null
        ? percentFormat.format(analysis.totals.read.value / analysis.totals.input.value) : '—'
      const peakContext = Math.max(0, ...analysis.calls.map((call) => call.input ?? 0))
      const facts = [
        ['Model calls', tokenTotal(analysis.totals.requests)],
        ['Input from cache', cacheShare],
        ['Peak context per call', peakContext ? compactFormat.format(peakContext) : '—'],
        ['Input tokens', tokenTotal(analysis.totals.input)],
        ['Output tokens', tokenTotal(analysis.totals.output)],
        ['Estimated API cost', recordedCost],
      ]
      if (analysis.sessions > 1) facts.unshift(['Sessions', numberFormat.format(analysis.sessions)])
      if (analysis.totals.nanoAiu.value !== null) facts.push(['Copilot nano-AIU', tokenTotal(analysis.totals.nanoAiu)])
      for (const [label, value] of facts) {
        const item = element('div')
        item.append(element('span', '', label), element('strong', '', value))
        summary.append(item)
      }

      const notes = findings(analysis)
      byId('findings-panel').hidden = notes.length === 0
      byId('findings-list').replaceChildren(...notes.map((note) => element('li', '', note)))

      renderTokenMix(analysis)
      renderTimeline(analysis.calls)

      const write5m = analysis.totals.cacheWrite5m.value ?? 0
      const write1h = analysis.totals.cacheWrite1h.value ?? 0
      const write = analysis.totals.write.value
      const input = analysis.totals.input.value
      const cacheRead = analysis.totals.read.value
      byId<HTMLSelectElement>('manual-model').value = findModelPrice(analysis.models[0]?.model ?? '')?.id ??
        byId<HTMLSelectElement>('manual-model').value
      const uncachedInput = input === null || cacheRead === null || write === null
        ? null : Math.max(0, input - cacheRead - write - write5m - write1h)
      byId<HTMLInputElement>('uncached-input').value = uncachedInput === null ? '' : String(uncachedInput)
      byId<HTMLInputElement>('cache-read').value = cacheRead === null ? '' : String(cacheRead)
      byId<HTMLInputElement>('cache-write').value = write === null ? '' : String(write)
      byId<HTMLInputElement>('cache-write-5m').value = String(write5m)
      byId<HTMLInputElement>('cache-write-1h').value = String(write1h)
      byId<HTMLInputElement>('output-tokens').value = analysis.totals.output.value === null
        ? '' : String(analysis.totals.output.value)
      renderComparison(analysis, analysis.workload)

      const modelPanel = byId<HTMLElement>('recorded-models')
      const modelBody = byId<HTMLTableSectionElement>('recorded-body')
      modelBody.replaceChildren()
      modelPanel.hidden = analysis.models.length === 0
      for (const model of analysis.models) {
        const row = element('tr')
        row.append(
          cell('th', model.model, 'row'),
          cell('td', tokenTotal(model.totals.requests)),
          cell('td', tokenTotal(model.totals.input)),
          cell('td', model.totals.input.value && model.totals.read.value !== null
            ? percentFormat.format(model.totals.read.value / model.totals.input.value) : '—'),
          cell('td', tokenTotal(model.totals.output)),
        )
        modelBody.append(row)
      }

      byId<HTMLElement>('tool-activity').hidden = analysis.tools.length === 0
      renderBars(byId('tools-chart'), [...analysis.tools].sort((a, b) => b.count - a.count).slice(0, 12).map((tool) => ({
        label: tool.name,
        value: tool.count,
        text: `${numberFormat.format(tool.count)}${tool.failed ? ` · ${tool.failed} failed` : ''}`,
      })))
      byId('failure-count').textContent = `${numberFormat.format(analysis.failedCalls)} failed model call${analysis.failedCalls === 1 ? '' : 's'}`

      const warningPanel = byId<HTMLElement>('warnings-panel')
      const warningList = byId<HTMLUListElement>('warnings-list')
      warningList.replaceChildren()
      warningPanel.hidden = analysis.warnings.length === 0
      for (const warning of analysis.warnings) warningList.append(element('li', '', warning))
    }

    let busy = false
    let analysisIsExample = false
    let focusResultsAfterAnalysis = true
    function setBusy(value: boolean) {
      busy = value
      fileInput.disabled = value
      byId<HTMLButtonElement>('demo-button').disabled = value
      byId<HTMLButtonElement>('manual-submit').disabled = value
      clearButton.disabled = value
    }

    function clearAnalysis() {
      results.hidden = true
      clearButton.hidden = true
      lastAnalysis = null
      pricingWorkload = []
      timelinePoints = []
      timelineIndex = -1
      byId('timeline-tip').hidden = true
      for (const id of ['summary', 'findings-list', 'token-mix', 'token-legend', 'timeline', 'cost-chart', 'comparison-sort-body', 'recorded-body', 'comparison-body', 'tools-chart', 'warnings-list']) {
        byId(id).replaceChildren()
      }
      for (const id of ['coverage', 'failure-count']) byId(id).textContent = ''
      for (const id of ['findings-panel', 'timeline-panel', 'recorded-models', 'tool-activity', 'warnings-panel']) byId<HTMLElement>(id).hidden = true
    }

    function analyze(request: WorkerRequest, label: string, focusResults = true) {
      if (busy) return
      clearAnalysis()
      analysisIsExample = Boolean(request.demo)
      focusResultsAfterAnalysis = focusResults
      setBusy(true)
      status.textContent = label
      worker.postMessage(request)
    }

    function loadFiles(files: File[]) {
      if (files.length) analyze({ files }, `Reading ${files.length} file${files.length === 1 ? '' : 's'} locally…`)
    }

    fileInput.addEventListener('change', () => {
      loadFiles(Array.from(fileInput.files ?? []))
      fileInput.value = ''
    })

    const dropzone = document.querySelector<HTMLElement>('.dropzone')!
    for (const eventName of ['dragenter', 'dragover']) {
      dropzone.addEventListener(eventName, (event) => {
        event.preventDefault()
        dropzone.classList.add('dragging')
      })
    }
    for (const eventName of ['dragleave', 'drop']) {
      dropzone.addEventListener(eventName, (event) => {
        event.preventDefault()
        dropzone.classList.remove('dragging')
      })
    }
    dropzone.addEventListener('drop', (event) => {
      loadFiles(Array.from((event as DragEvent).dataTransfer?.files ?? []))
    })

    worker.addEventListener('message', ({ data }: MessageEvent<WorkerResponse>) => {
      if (data.type === 'progress') {
        status.textContent = `Read ${data.done} of ${data.total} files locally…`
      } else if (data.type === 'result') {
        setBusy(false)
        showAnalysis(data.analysis, analysisIsExample)
        status.textContent = analysisIsExample
          ? 'Sample report loaded. Add a session below to replace it.'
          : 'Analysis complete. Files were processed in this browser.'
        if (focusResultsAfterAnalysis) results.focus()
      } else {
        setBusy(false)
        status.textContent = data.message
      }
    })
    worker.addEventListener('error', () => {
      setBusy(false)
      status.textContent = 'The local analysis worker stopped unexpectedly. Try a smaller export.'
    })

    byId<HTMLButtonElement>('demo-button').addEventListener('click', () => analyze({ demo: demoEvents }, 'Loading sample report…'))
    byId<HTMLButtonElement>('clear-button').addEventListener('click', () => {
      clearAnalysis()
      status.textContent = 'Results cleared.'
    })

    for (const radio of document.querySelectorAll<HTMLInputElement>('input[name="timeline-mode"]')) {
      radio.addEventListener('change', () => {
        timelineMode = radio.value === 'total' ? 'total' : 'call'
        drawTimeline()
      })
    }
    let chartWidth = 0
    let resizeFrame = 0
    new ResizeObserver(([entry]) => {
      const next = Math.round(entry.contentRect.width)
      if (!next || next === chartWidth) return
      chartWidth = next
      cancelAnimationFrame(resizeFrame)
      resizeFrame = requestAnimationFrame(() => { if (timelinePoints.length) drawTimeline() })
    }).observe(byId('timeline'))

    const manualForm = byId<HTMLFormElement>('manual-form')
    const manualError = byId<HTMLParagraphElement>('manual-error')
    function currentManualUsage() {
      return manualUsage(
        byId<HTMLSelectElement>('manual-model').value,
        parseTokenInput(byId<HTMLInputElement>('uncached-input').value),
        parseTokenInput(byId<HTMLInputElement>('cache-read').value),
        parseTokenInput(byId<HTMLInputElement>('cache-write').value),
        parseTokenInput(byId<HTMLInputElement>('output-tokens').value),
        parseTokenInput(byId<HTMLInputElement>('cache-write-5m').value),
        parseTokenInput(byId<HTMLInputElement>('cache-write-1h').value),
      )
    }

    function refreshComparison() {
      if (!lastAnalysis) return
      try {
        manualError.hidden = true
        renderComparison(lastAnalysis, [currentManualUsage()])
      } catch (cause) {
        manualError.textContent = cause instanceof Error ? cause.message : 'Enter valid token counts.'
        manualError.hidden = false
      }
    }

    manualForm.addEventListener('input', refreshComparison)
    for (const control of manualForm.querySelectorAll('select')) {
      control.addEventListener('change', refreshComparison)
    }
    for (const button of document.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
      button.addEventListener('click', () => {
        const next = button.dataset.sort as typeof sortBy
        if (next === sortBy) sortDirection = sortDirection === 1 ? -1 : 1
        else { sortBy = next; sortDirection = 1 }
        for (const option of document.querySelectorAll<HTMLButtonElement>('[data-sort]')) {
          option.closest('th')?.setAttribute('aria-sort', option === button
            ? sortDirection === 1 ? 'ascending' : 'descending'
            : 'none')
        }
        if (lastAnalysis) renderComparison(lastAnalysis, pricingWorkload)
      })
    }

    manualForm.addEventListener('submit', (event) => {
      event.preventDefault()
      manualError.hidden = true
      try {
        const record = currentManualUsage()
        showAnalysis(analyzeUsage([{ usage: [record], tools: [], warnings: [], recognized: 1, sources: [] }]))
        status.textContent = 'Estimate calculated from your manual token assumptions.'
        results.focus()
      } catch (cause) {
        manualError.textContent = cause instanceof Error ? cause.message : 'Enter valid token counts.'
        manualError.hidden = false
      }
    })

    showAnalysis(analyzeUsage([parseUsage(demoEvents)]), true)
    status.textContent = 'Sample report loaded. Add a session below to replace it.'
  </script>

