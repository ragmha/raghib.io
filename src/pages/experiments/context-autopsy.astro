    }

    .calculator :global(.highlight .bar-fill) {
      background: var(--theme-highlight);
      outline: 1px solid var(--theme-rule-strong);
    }

    .calculator :global(.bar-range) {
      background: color-mix(in srgb, var(--theme-muted) 35%, transparent);
    }

    .calculator :global(.bar-value) {
      text-align: right;
      font-variant-numeric: tabular-nums;
    }

    .rate-table summary {
      cursor: pointer;
      margin: 1rem 0 0.5rem;
    }

    .import-panel > summary,
    .manual-entry > summary,
    .warnings > summary {
