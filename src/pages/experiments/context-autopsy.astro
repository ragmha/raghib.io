      color: var(--theme-text);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .sortable th[aria-sort="ascending"] button::after { content: " ↑"; }
    .sortable th[aria-sort="descending"] button::after { content: " ↓"; }

    .sortable :global(tr.recorded) {
      background: color-mix(in srgb, var(--theme-highlight) 12%, transparent);
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 600px) {
      .token-inputs,
      .summary,
      .sources div {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.25rem;
      }

      .bar-chart :global(li) {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 0.25rem 1rem;
      }

      .calculator :global(.bar-track) {
        grid-column: 1 / -1;
        grid-row: 2;
      }
    }
  </style>
</SiteLayout>
