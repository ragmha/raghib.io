    .token-inputs label {
      display: grid;
      grid-template-rows: 1fr auto;
      align-items: end;
      gap: 0.35rem;
      font-size: 0.85rem;
    }

    .error {
      color: #ff9b8f;
    }

    .results {
      margin-top: 1.5rem;
    }

    .results-head h2 {
      margin: 0;
      font-size: 1.1rem;
    }

    .results-head .coverage {
      margin: 0.3rem 0 0;
    }

    .summary {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
      margin-top: 1rem;
      border-block: 1px solid var(--calc-line);
    }

    .summary > :global(div) {
      display: grid;
      gap: 0.25rem;
      min-width: 0;
      padding: 0.7rem 0.8rem 0.7rem 0;
    }

    .summary :global(span) {
      color: var(--calc-muted);
      font-size: 0.75rem;
    }

    .summary :global(strong) {
      overflow-wrap: anywhere;
      font-size: 1.05rem;
      font-variant-numeric: tabular-nums;
    }

    .dashboard-tabs {
      display: flex;
      gap: 1.25rem;
      margin-top: 1rem;
      overflow-x: auto;
      border-bottom: 1px solid var(--calc-line);
    }

    .dashboard-tabs button {
      flex: 0 0 auto;
      min-height: 2.75rem;
      padding: 0.55rem 0;
      border: 0;
      border-bottom: 2px solid transparent;
      background: transparent;
      color: var(--calc-muted);
      font: inherit;
      cursor: pointer;
    }

    .dashboard-tabs button[aria-selected="true"] {
      border-bottom-color: var(--theme-text);
      color: var(--theme-text);
    }

    .dashboard-tabs button:hover {
      color: var(--theme-text);
    }

    .tab-panel {
      margin-top: 1rem;
    }

    .tab-panel:focus-visible {
      outline-offset: 4px;
    }

    .overview-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.55fr) minmax(16rem, 0.9fr);
      align-items: start;
      gap: 1rem;
    }

    .overview-side {
      display: grid;
      align-content: start;
      gap: 1rem;
    }

    .overview-grid > .panel,
    .overview-side > .panel,
    .tab-panel > .panel + .panel {
      margin-top: 0;
    }

    .table-wrap {
      overflow-x: auto;
    }

    .panel table {
      width: 100%;
      margin-top: 0.5rem;
      border-collapse: collapse;
      font-size: 0.78rem;
    }

    .panel :global(th),
    .panel :global(td) {
      padding: 0.55rem 0.45rem;
      border-bottom: 1px solid var(--calc-line);
      text-align: right;
      white-space: nowrap;
    }

    .panel :global(th:first-child),
    .panel :global(td:first-child) {
      text-align: left;
    }

    .panel thead th {
      color: var(--calc-muted);
      font-weight: 500;
    }

    .panel :global(tr.recorded) {
      background: color-mix(in srgb, var(--theme-text) 8%, transparent);
    }

    .panel ul {
      margin-bottom: 0;
    }

    .warnings {
      border-color: #806b3d;
    }

    .sources {
      display: grid;
      gap: 0.5rem;
      margin: 1rem 0;
    }

    .sources div {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1rem;
    }

    .sources dd {
      margin: 0;
      overflow-wrap: anywhere;
    }

    .calculator :global(.segment.fresh) { background: var(--signature-fresh); }
    .calculator :global(.segment.read) { background: var(--signature-read); }
    .calculator :global(.segment.write) { background: var(--signature-write); }
    .calculator :global(.segment.output) { background: var(--signature-output); }

    .calculator :global(.token-mix) {
      display: flex;
      height: 2.25rem;
      gap: 1px;
      margin-top: 0.85rem;
      overflow: hidden;
      border: 1px solid var(--calc-line);
      background: var(--calc-line);
    }

    .calculator :global(.token-mix .segment) {
      display: grid;
      min-width: 0;
      place-items: center;
      overflow: hidden;
      color: var(--signature-ink);
      font-size: 0.72rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      white-space: nowrap;
    }

    .calculator :global(.token-total) {
      color: var(--calc-muted);
      font-size: 0.78rem;
      font-variant-numeric: tabular-nums;
    }

    .calculator :global(.legend) {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem 1.5rem;
      padding: 0;
      list-style: none;
      color: var(--calc-muted);
      font-size: 0.875rem;
    }

    .calculator :global(.swatch) {
      display: inline-block;
      width: 0.75rem;
      height: 0.75rem;
      margin-right: 0.5rem;
      vertical-align: -0.05rem;
    }

    .calculator :global(.swatch.fresh) { background: var(--signature-fresh); }
    .calculator :global(.swatch.read) { background: var(--signature-read); }
    .calculator :global(.swatch.write) { background: var(--signature-write); }
    .calculator :global(.swatch.output) { background: var(--signature-output); }

    .signature-panel .legend {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.55rem 0.8rem;
      margin-top: 0.75rem;
      font-size: 0.75rem;
    }

    .chart-head {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      justify-content: space-between;
      gap: 0.5rem 1rem;
    }

    .toggle {
      display: flex;
      gap: 1rem;
      margin: 0;
      padding: 0;
      border: 0;
      font-size: 0.85rem;
    }

    .visually-hidden {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
    }

    .chart-wrap {
      position: relative;
      margin-top: 1rem;
    }

    .context-chart {
      display: block;
      width: 100%;
      height: 17.5rem;
      touch-action: pan-y;
      cursor: crosshair;
    }

    @media (max-width: 36rem) {
      .context-chart { height: 14rem; }
    }

    .context-chart:focus-visible {
      outline: 2px solid var(--theme-text);
      outline-offset: 4px;
    }

    .calculator :global(.context-chart .grid) { stroke: var(--theme-rule); }
    .calculator :global(.context-chart .axis) { fill: var(--calc-muted); font-size: 11px; font-family: inherit; }
    .calculator :global(.context-chart .area.read) { fill: var(--signature-read); }
    .calculator :global(.context-chart .area.fresh) { fill: var(--signature-fresh); }
    .calculator :global(.context-chart .area.output) { fill: var(--signature-output); }
    .calculator :global(.context-chart .edge) { fill: none; stroke: var(--theme-rule-strong); stroke-width: 1; vector-effect: non-scaling-stroke; }
    .calculator :global(.context-chart .hit) { fill: transparent; }
    .calculator :global(.context-chart .guide line) { stroke: var(--theme-text); stroke-dasharray: 3 3; }
    .calculator :global(.context-chart .guide circle) { fill: var(--theme-bg, Canvas); stroke: var(--theme-text); stroke-width: 2; }

    .chart-tip {
      position: absolute;
      top: 0.5rem;
      display: grid;
      gap: 0.15rem;
      min-width: 13rem;
      padding: 0.6rem 0.75rem;
      border: 1px solid var(--theme-rule-strong);
      background: var(--theme-bg, Canvas);
      font-size: 0.8rem;
      pointer-events: none;
    }

    .chart-tip :global(span:empty) { display: none; }

    .findings {
      display: grid;
      gap: 0.5rem;
      margin: 0.75rem 0 0;
      padding-left: 1.1rem;
    }

    .more-findings {
      margin-top: 0.75rem;
    }

    .more-findings summary {
      color: var(--calc-muted);
      cursor: pointer;
      font-size: 0.82rem;
    }

    .calculator .bar-chart {
      display: grid;
      gap: 0.5rem;
      margin: 1rem 0;
      padding: 0;
      list-style: none;
    }

    .bar-chart :global(li) {
      display: grid;
      grid-template-columns: 11rem minmax(0, 1fr) 9rem;
      align-items: center;
      gap: 1rem;
      color: var(--calc-muted);
      font-size: 0.875rem;
    }

    .bar-chart :global(li.highlight) {
      color: var(--theme-text);
      font-weight: 700;
    }

    .calculator :global(.bar-track) {
      display: flex;
