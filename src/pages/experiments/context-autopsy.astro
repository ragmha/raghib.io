    }

    .sortable th button {
      padding: 0;
      border: 0;
      background: transparent;
      color: inherit;
      font: inherit;
      text-align: inherit;
      cursor: pointer;
    }

    .sortable th button:hover,
    .sortable th button:focus-visible {
      color: var(--theme-text);
      text-decoration: underline;
      text-underline-offset: 0.2em;
    }

    .sortable th[aria-sort="ascending"] button::after { content: " ↑"; }
    .sortable th[aria-sort="descending"] button::after { content: " ↓"; }

    .sortable :global(tr.recorded) {
      background: color-mix(in srgb, var(--theme-highlight) 12%, transparent);
    }

    [hidden] {
      display: none !important;
    }

    @media (max-width: 600px) {
      .token-inputs,
      .sources div {
        grid-template-columns: minmax(0, 1fr);
        gap: 0.25rem;
