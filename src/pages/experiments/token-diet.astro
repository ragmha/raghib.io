---
import SiteLayout from '../../layouts/SiteLayout.astro'
import data from '../../data/token-diet.json'
import { correlation, cost, kinds, median, medianRun, total } from '../../lib/token-diet'
import type { Call, Kind, Run, Tokens } from '../../lib/token-diet'

const runs = data.runs as Run[]
const rates = data.rates as Tokens
const number = new Intl.NumberFormat('en-US')
const percent = new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 1 })
const wholePercent = new Intl.NumberFormat('en-US', { style: 'percent', maximumFractionDigits: 0 })
const perThousand = new Intl.NumberFormat('en-US', { maximumFractionDigits: 3 })
const thousands = (value: number) => `${Math.round(value / 1000)}k`
const aiu = (nano: number) => (nano / 1e9).toFixed(2)
const signed = (value: number) => `${value < 0 ? '−' : '+'}${number.format(Math.abs(value))}`

const names: Record<Kind, string> = {
  cacheRead: 'Cache read',
  cacheWrite: 'Cache write',
  fresh: 'Fresh input',
  output: 'Output',
}

const setups = [
  { id: 'a', name: 'Baseline' },
  { id: 'b', name: 'Principles' },
  { id: 'c', name: 'caveman' },
  { id: 'd', name: 'rtk' },
  { id: 'e', name: 'All three' },
].map((setup) => {
  const set = runs.filter((run) => run.variant === setup.id)
  const sizes = set.map((run) => total(run.totals))
  const charges = set.map((run) => run.nanoAiu)
  return {
    ...setup,
    lane: `${setup.id === 'a' ? 'Before' : 'After'} · ${setup.name}`,
    set,
    shown: medianRun(set),
    succeeded: set.filter((run) => run.success).length,
    tokens: median(sizes),
    low: Math.min(...sizes),
    high: Math.max(...sizes),
    calls: median(set.map((run) => run.calls.length)),
    aiu: median(charges),
    aiuLow: Math.min(...charges),
    aiuHigh: Math.max(...charges),
    prompt: median(set.map((run) => total(run.calls[0]) - run.calls[0].output)),
    firstAiu: median(set.map((run) => cost(run.calls[0], rates))),
    prose: median(set.map((run) => run.proseChars)),
    proseShare: median(set.map((run) => run.proseChars / (run.proseChars + run.argChars))),
    biggestResult: Math.max(...set.flatMap((run) => run.calls.flatMap((call) => call.tools.map((tool) => tool.outTokens)))),
  }
})
const [baseline, principles, caveman, rtk, all] = setups
const after = setups.slice(1)

const pooled = Object.fromEntries(kinds.map((kind) => [kind, runs.reduce((sum, run) => sum + run.totals[kind], 0)])) as Tokens
const tokenShare = (kind: Kind) => percent.format(pooled[kind] / total(pooled))
const costShare = (kind: Kind) => percent.format((pooled[kind] * rates[kind]) / cost(pooled, rates))
const callsVsTokens = correlation(runs.map((run) => run.calls.length), runs.map((run) => total(run.totals)))
const lastCall = median(runs.map((run) => total(run.calls[run.calls.length - 1])))
const sharedPrefix = runs[0].calls[0].cacheRead
const testRuns = runs.reduce((sum, run) => sum + run.testRuns, 0)
const rtkSaved = median(rtk.set.map((run) => run.rtk?.saved ?? 0))
const extraSkills = caveman.set[0].skills - baseline.set[0].skills
const narrowestSpread = Math.min(...setups.map((setup) => setup.high - setup.low))
const widestGap = Math.max(...setups.map((setup) => setup.tokens)) - Math.min(...setups.map((setup) => setup.tokens))
const largest = runs.reduce((max, run) => (total(run.totals) > total(max.totals) ? run : max))
const failed = runs.filter((run) => !run.success)
const why = (run: Run) =>
  !run.committed ? 'made no commit'
    : !run.testsPass ? 'left tests failing'
      : 'fixed the bugs but used a commit scope the repository’s guide does not allow'
const nameOf = (run: Run) => setups.find((setup) => setup.id === run.variant)?.name ?? run.variant

// Race: each setup's median run, call by call, on one token axis.
const axis = Math.ceil(Math.max(...setups.map((setup) => total(setup.shown.totals))) / 100_000) * 100_000
const ticks = Array.from({ length: axis / 100_000 + 1 }, (_, i) => i * 100_000)
const pct = (value: number, of: number) => `${((value / of) * 100).toFixed(3)}%`
const blocks = (calls: Call[]) => {
  let start = 0
  return calls.map((call) => {
    const size = total(call)
    const block = { call, start, size }
    start += size
    return block
  })
}
const stops = (values: number[]) => {
  const sum = values.reduce((a, b) => a + b, 0)
  let running = 0
  return values.map((value, i) => `--s${i + 1}:${((running += value) / sum).toFixed(4)}`).join(';')
}
const pick = ({ cacheRead, cacheWrite, fresh, output }: Tokens): Tokens => ({ cacheRead, cacheWrite, fresh, output })
const raceJson = JSON.stringify({
  axis,
  rates,
  lanes: Object.fromEntries(setups.map((setup) => [setup.id, setup.shown.calls.map(pick)])),
}).replace(/</g, '\\u003c')

// Every run: one dot per run on a shared axis.
const stripMax = Math.ceil(total(largest.totals) / 100_000) * 100_000
const stripTicks = [0, 1, 2, 3].map((i) => (stripMax / 3) * i)

const description =
  'One bug-fix task, 25 coding-agent runs: as-is, with simple principles, caveman, rtk and all three. See where the tokens and the cost actually went.'
---

<SiteLayout title="Coding Agent Token Diet: Before and After" description={description}>
  <Fragment slot="heading">Does Your Coding Agent Need a Token Diet?</Fragment>
  <div class="diet">
    <p class="lede">
      Advice for cutting a coding agent’s token use is easy to find: give it rules, make it terse, filter what
      commands print. I tried three versions of that on one task — find and fix three bugs in a small Python
      invoicing library, then commit the fixes — and ran each setup five times with the same agent and model.
    </p>
    <p>
      <strong>Short answer: not for this task.</strong> No setup used fewer tokens than the baseline at the
      median, and runs of the same setup differed more than the setups did.
    </p>

    <section class="race" aria-labelledby="race-title">
      <h2 id="race-title">Before and after, call by call</h2>
      <div class="controls">
        <fieldset>
          <legend>Compare the baseline with</legend>
          {after.map((setup) => (
            <label>
              <input type="radio" name="after" id={`after-${setup.id}`} value={setup.id} checked={setup.id === 'e'} />
              {setup.name}
            </label>
          ))}
        </fieldset>
        <button type="button" class="replay">Replay</button>
      </div>

      <figure>
        <div class="lanes" style={`--divisions:${ticks.length - 1}`}>
          {setups.map((setup) => {
            const size = total(setup.shown.totals)
            const meters = [
              ['tokens', number.format(size)],
              ['calls', String(setup.shown.calls.length)],
              ['AIU', aiu(setup.shown.nanoAiu)],
            ]
            return (
              <div class="lane" data-lane={setup.id} style={`--at:${(size / axis).toFixed(4)}`}>
                <div class="lane-head">
                  <span class="lane-name">
                    {setup.lane} <span class="muted">run {setup.shown.id}</span>
                    <span class="visually-hidden">
                      : {number.format(size)} tokens, {setup.shown.calls.length} model calls, {aiu(setup.shown.nanoAiu)} AIU
                    </span>
                  </span>
                  <dl class="meters" aria-hidden="true">
                    {meters.map(([label, value]) => (
                      <div>
                        <dt>{label}</dt>
                        <dd data-meter={label} style={`--chars:${value.length}`}>{value}</dd>
                      </div>
                    ))}
                  </dl>
                </div>
                <div class="track" aria-hidden="true">
                  <div class="blocks">
                    {blocks(setup.shown.calls).map(({ call, start, size: callSize }, i) => (
                      <div class="call" style={`--x:${pct(start, axis)};--w:${pct(callSize, axis)}`}>
                        <div class="segments">
                          {kinds.map((kind) => <span class={kind} style={`flex-grow:${call[kind]}`} />)}
                          <span class="number">{i + 1}</span>
                        </div>
                        <div class="tools">
                          {call.tools.map((tool) => (
                            <span class:list={{ failed: !tool.ok }} title={`${tool.name}: ${tool.label}`} />
                          ))}
                        </div>
                      </div>
                    ))}
                  </div>
                  <span class="head" />
                </div>
              </div>
            )
          })}
          <div class="axis" aria-hidden="true">
            {ticks.map((tick) => <span style={`--x:${pct(tick, axis)}`}>{tick ? thousands(tick) : '0'}</span>)}
          </div>
        </div>

        <div class="summary">
          {setups.map((setup) => (
            <div class="donut" data-lane={setup.id}>
              <div class="rings" aria-hidden="true">
                <span class="ring ring-tokens" style={stops(kinds.map((kind) => setup.shown.totals[kind]))} />
                <span class="ring ring-cost" style={stops(kinds.map((kind) => setup.shown.totals[kind] * rates[kind]))} />
              </div>
              <span>{setup.lane}</span>
            </div>
          ))}
          <div class="legend">
            <p>Outer ring: share of tokens. Inner ring: share of AIU.</p>
            <ul>
              {kinds.map((kind) => (
                <li>
                  <span class:list={['swatch', kind]} aria-hidden="true" />
                  {names[kind]} <span class="muted">{perThousand.format(rates[kind] / 1e6)} AIU per 1k tokens</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <figcaption>
          Each block is one model call, as wide as the tokens it processed: cache reads, cache writes, fresh input
          and output, left to right. The thin marks under a block are the tools that call asked for. Lanes fill at
          the same token rate, so the run that uses fewer tokens finishes first. Each lane is that setup’s median
          run by total tokens; the table below has all 25.
        </figcaption>

        <details class="ran">
          <summary>What the agent ran in these runs</summary>
          {setups.map((setup) => (
            <section data-lane={setup.id}>
              <h3>{setup.lane}, run {setup.shown.id}</h3>
              <ol>
                {setup.shown.calls.map((call) => (
                  <li>
                    <span class="muted">{number.format(total(call))} tokens</span>
                    {call.tools.length
                      ? call.tools.map((tool) => <code>{tool.name}: {tool.label}{tool.ok ? '' : ' (failed)'}</code>)
                      : <span>final reply</span>}
                  </li>
                ))}
              </ol>
            </section>
          ))}
        </details>
      </figure>
      <script is:inline type="application/json" id="race-data" set:html={raceJson} />
    </section>

    <section aria-labelledby="runs-title">
      <h2 id="runs-title">Every run</h2>
      <figure class="strip">
        <div class="strip-rows" aria-hidden="true">
          {setups.map((setup) => (
            <div class="strip-row">
              <span>{setup.name}</span>
              <div class="strip-track">
                <span class="median" style={`--x:${pct(setup.tokens, stripMax)}`} />
                {setup.set.map((run) => (
                  <span class:list={['dot', { failed: !run.success }]} style={`--x:${pct(total(run.totals), stripMax)}`} />
                ))}
              </div>
            </div>
          ))}
          <div class="strip-row">
            <span />
            <div class="axis">
              {stripTicks.map((tick) => <span style={`--x:${pct(tick, stripMax)}`}>{tick ? thousands(tick) : '0'}</span>)}
            </div>
          </div>
        </div>
        <figcaption>
          Total tokens per run. Each dot is a run; the hollow dot is the run that failed; the line marks the median.
        </figcaption>
      </figure>

      <div class="table-wrap">
        <table>
          <caption>
            Medians over five runs per setup, failed run included. First-call prompt is what the agent sends before
            doing anything: system prompt, {number.format(data.toolDefinitionsTokens)} tokens of tool definitions,
            instructions, skill list and the task.
          </caption>
          <thead>
            <tr>
              <th scope="col">Setup</th>
              <th scope="col">Succeeded</th>
              <th scope="col">Median tokens</th>
              <th scope="col">Range</th>
              <th scope="col">Calls</th>
              <th scope="col">AIU</th>
              <th scope="col">First-call prompt</th>
            </tr>
          </thead>
          <tbody>
            {setups.map((setup) => (
              <tr>
                <th scope="row">{setup.name}</th>
                <td>{setup.succeeded}/{setup.set.length}</td>
                <td>{number.format(setup.tokens)}</td>
                <td>{thousands(setup.low)}–{thousands(setup.high)}</td>
                <td>{setup.calls}</td>
                <td>{aiu(setup.aiu)}</td>
                <td>
                  {number.format(setup.prompt)}
                  {setup !== baseline && <span class="muted"> ({signed(setup.prompt - baseline.prompt)})</span>}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <section aria-labelledby="findings-title">
      <h2 id="findings-title">What the runs show</h2>
      <p>
        <strong>No setup beat the baseline.</strong> The baseline’s median run used {number.format(baseline.tokens)}
        tokens. The medians for {after.map((setup) => setup.name.toLowerCase()).join(', ')} were
        {' '}{after.map((setup) => number.format(setup.tokens)).join(', ')}. {failed.length === 1 ? 'One run' : `${failed.length} runs`} of 25
        failed: {failed.map((run) => `${run.id} (${nameOf(run)}) ${why(run)}`).join('; ')}.
      </p>
      <p>
        <strong>Noise was bigger than the differences.</strong> Within every setup, the largest run used at least
        {' '}{number.format(narrowestSpread)} more tokens than the smallest; the widest gap between two setups’ medians
        was {number.format(widestGap)}. Five runs each can’t tell these setups apart. The single largest run,
        {' '}{largest.id} ({nameOf(largest)}), used {number.format(total(largest.totals))} tokens over
        {' '}{largest.calls.length} calls.
      </p>
      <p>
        <strong>Calls drove tokens.</strong> Across all 25 runs, total tokens tracked the number of model calls
        (Pearson r = {callsVsTokens.toFixed(2)}). Every call re-reads the whole conversation so far, so calls grow
        as a run goes on: the last call of a run processed a median {number.format(lastCall)} tokens.
      </p>
      <p>
        <strong>Tokens aren’t the bill.</strong> Cache reads were {tokenShare('cacheRead')} of all tokens but
        {' '}{costShare('cacheRead')} of the AIU. Cache writes were {tokenShare('cacheWrite')} of tokens and
        {' '}{costShare('cacheWrite')} of AIU; output was {tokenShare('output')} of tokens and {costShare('output')}
        of AIU. So the two can disagree: rtk’s median was above the baseline’s in tokens
        ({number.format(rtk.tokens)} against {number.format(baseline.tokens)}) but the lowest of all in AIU
        ({aiu(rtk.aiu)} against {aiu(baseline.aiu)}), though still inside the baseline’s own range of
        {' '}{aiu(baseline.aiuLow)}–{aiu(baseline.aiuHigh)}.
      </p>
      <p>
        <strong>Principles added little and didn’t cut calls.</strong> The six rules added
        {' '}{number.format(principles.prompt - baseline.prompt)} tokens to the prompt. Their runs took a median of
        {' '}{principles.calls} calls against the baseline’s {baseline.calls}.
      </p>
      <p>
        <strong>caveman added context and didn’t cut prose.</strong> Installing it added
        {' '}{number.format(caveman.prompt - baseline.prompt)} tokens to the first prompt — a
        {' '}{number.format(caveman.set[0].hookChars)}-character session-start instruction and {extraSkills} more
        skills in the skill list. Writing them to the cache made its first call cost {aiu(caveman.firstAiu)} AIU
        against the baseline’s {aiu(baseline.firstAiu)}, and every later call re-reads them. Median prose per run went from
        {' '}{number.format(baseline.prose)} to {number.format(caveman.prose)} characters. Prose is the small part
        anyway: {wholePercent.format(1 - baseline.proseShare)} of what the baseline agent wrote was tool input, such
        as commands and edits.
      </p>
      <p>
        <strong>The agent already did rtk’s job.</strong> A plain run of the failing suite prints
        {' '}{number.format(data.fixture.outputLines)} lines. The agent ran the suite {testRuns} times across the 25
        runs and piped the output through a filter such as <code>tail</code> or <code>grep</code> every time, in every
        setup. The largest single tool result was smaller with rtk ({number.format(rtk.biggestResult)} tokens, against
        {' '}{number.format(baseline.biggestResult)} at baseline), and rtk reported a median
        {' '}{number.format(rtkSaved)} tokens saved per run — its own estimate, and less than a single late call
        processes. Its instruction and hook added {number.format(rtk.prompt - baseline.prompt)} tokens to the prompt.
      </p>
      <p>
        <strong>All three together</strong> added {number.format(all.prompt - baseline.prompt)} tokens to the prompt,
        made the first call cost {aiu(all.firstAiu)} AIU and had the highest median AIU, {aiu(all.aiu)}.
      </p>
    </section>

    <section aria-labelledby="takeaways-title">
      <h2 id="takeaways-title">What I’d take from it</h2>
      <p class="muted">Opinion, from one task and one model.</p>
      <ul>
        <li>
          <strong>Count calls before words.</strong> Each call re-reads everything so far, so the number of calls set
          the token count here far more than how much the agent wrote.
        </li>
        <li>
          <strong>Price what a tool adds to every prompt.</strong> Instructions, hooks and skill lists ride along on
          every call. A tool has to save more than that before it saves anything.
        </li>
        <li>
          <strong>Check what your agent already does.</strong> This one trimmed its own command output, so an output
          filter had little left to take. Output filters should matter more where an agent reads long, raw logs.
        </li>
        <li>
          <strong>Measure with enough runs.</strong> Single sessions vary too much to judge a setup. Run your own
          tasks many times and compare the spread, not one before and one after.
        </li>
      </ul>
    </section>

    <section aria-labelledby="method-title">
      <h2 id="method-title">How it was run</h2>
      <dl class="method">
        <div>
          <dt>Task</dt>
          <dd>
            A small Python invoicing library with {data.fixture.tests} tests, {data.fixture.failing} of them failing
            with {number.format(data.fixture.outputLines)} lines of test output. Three seeded bugs: money rounded half
            to even instead of half up; a zero tax-rate override fell back to the standard rate; and in tax-exclusive
            regions, tax was charged before a line’s share of the coupon. The prompt, the same for every run:
            <blockquote><p>{data.prompt}</p></blockquote>
          </dd>
        </div>
        <div>
          <dt>Agent</dt>
          <dd>
            GitHub Copilot CLI {data.versions.copilot}, non-interactive (<code>copilot -p</code>), model
            {' '}<code>{data.model}</code> at {data.effort} reasoning effort, memory off.
          </dd>
        </div>
        <div>
          <dt>Setups</dt>
          <dd>
            <ul>
              <li><strong>Baseline:</strong> the CLI as installed.</li>
              <li>
                <strong>Principles:</strong> six rules in the user instructions file:
                <ol>
                  {data.principles.map((rule) => (
                    <li>{rule.split('`').map((part, i) => (i % 2 ? <code>{part}</code> : part))}</li>
                  ))}
                </ol>
              </li>
              <li>
                <strong>caveman</strong> (<a href="https://github.com/JuliusBrussee/caveman">source</a>, commit
                {' '}{data.versions.caveman}): installed with its own installer for Copilot, which adds a
                session-start hook that switches the agent to terse replies, and {extraSkills} skills.
              </li>
              <li>
                <strong>rtk</strong> (<a href="https://github.com/rtk-ai/rtk">source</a>, {data.versions.rtk}):
                {' '}<code>rtk init -g --copilot --auto-patch --no-trust-filters</code>, which adds an instruction to run
                commands through rtk and a hook that rewrites them, so rtk filters their output.
              </li>
              <li><strong>All three:</strong> everything above in one setup.</li>
            </ul>
          </dd>
        </div>
        <div>
          <dt>Isolation</dt>
          <dd>
            Every run got a fresh copy of the repository and a fresh home directory holding only its setup, with no
            other environment from my machine. Five rounds; each round started all five setups at once.
          </dd>
        </div>
        <div>
          <dt>Success</dt>
          <dd>
            The fixes are committed, every commit subject follows the repository’s contributing guide, and the
            original tests plus a hidden acceptance test pass on the committed code. No run edited the tests.
          </dd>
        </div>
        <div>
          <dt>Measures</dt>
          <dd>
            Tokens per model call from the CLI’s session log. AIU is Copilot’s usage unit: the log records a rate for
            each kind of token, the same in every run, and tokens times those rates reproduce each run’s recorded
            total exactly. Every run’s first call found the same opening {number.format(sharedPrefix)} prompt tokens
            already cached, so no setup started with a warmer cache. Python {data.versions.python}, pytest
            {' '}{data.versions.pytest}.
          </dd>
        </div>
        <div>
          <dt>Limits</dt>
          <dd>
            One task, one agent, one model, five runs per setup. Medians include the failed run. rtk’s savings
            figure is its own estimate. Other token-saving tools weren’t tested.
          </dd>
        </div>
      </dl>
      <p>
        <a href="https://github.com/ragmha/raghib.io/tree/main/scripts/token-diet">The kit</a> rebuilds the
        repository, re-runs every setup and regenerates this page’s data.
      </p>
    </section>
  </div>

  <script>
    import { cost, kinds, reveal, total } from '../../lib/token-diet'
    import type { Tokens } from '../../lib/token-diet'

    const race = document.querySelector<HTMLElement>('.race')
    const source = document.getElementById('race-data')
    const still = matchMedia('(prefers-reduced-motion: reduce)')

    if (race && source && !still.matches) {
      const { axis, rates, lanes } = JSON.parse(source.textContent ?? '') as {
        axis: number
        rates: Tokens
        lanes: Record<string, Tokens[]>
      }
      const number = new Intl.NumberFormat('en-US')
      const views = Object.entries(lanes).map(([id, calls]) => ({
        calls,
        size: calls.reduce((sum, call) => sum + total(call), 0),
        lane: race.querySelector<HTMLElement>(`.lane[data-lane="${id}"]`)!,
        rings: [...race.querySelectorAll<HTMLElement>(`.donut[data-lane="${id}"] .ring`)],
      }))
      const replay = race.querySelector<HTMLButtonElement>('.replay')!
      const fill = (ring: HTMLElement, values: number[]) => {
        const sum = values.reduce((a, b) => a + b, 0)
        let running = 0
        values.forEach((value, i) => ring.style.setProperty(`--s${i + 1}`, String(sum ? (running += value) / sum : 0)))
      }
      const draw = (at: number) => {
        for (const view of views) {
          const shown = reveal(view.calls, at)
          const meter = (name: string, value: string) => {
            view.lane.querySelector(`[data-meter="${name}"]`)!.textContent = value
          }
          view.lane.style.setProperty('--at', String(Math.min(at, view.size) / axis))
          meter('tokens', number.format(Math.min(at, view.size)))
          meter('calls', String(shown.calls))
          meter('AIU', (cost(shown.tokens, rates) / 1e9).toFixed(2))
          fill(view.rings[0], kinds.map((kind) => shown.tokens[kind]))
          fill(view.rings[1], kinds.map((kind) => shown.tokens[kind] * rates[kind]))
        }
      }
      let frame = 0
      const play = () => {
        cancelAnimationFrame(frame)
        const end = Math.max(...views.filter((view) => view.lane.getClientRects().length).map((view) => view.size))
        const started = performance.now()
        const step = (now: number) => {
          const at = Math.min(((now - started) / 4000) * axis, end)
          draw(at)
          if (at < end) frame = requestAnimationFrame(step)
        }
        frame = requestAnimationFrame(step)
      }

      draw(0)
      replay.classList.add('ready')
      replay.addEventListener('click', play)
      race.addEventListener('change', play)
      const observer = new IntersectionObserver((entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return
        observer.disconnect()
        play()
      }, { threshold: 0.5 })
