---
import SiteLayout from '../layouts/SiteLayout.astro'
import PostList from '../components/PostList.astro'
import { formatDate, getPostSlug, getPublishedPosts } from '../lib/posts'

const latestPosts = (await getPublishedPosts()).slice(0, 3)
---

<SiteLayout
  title="Software, AI & Systems"
  heading="How technology becomes useful"
  description="Independent writing by Raghib Hasan on AI, software, and the systems that turn promising technology into useful, trustworthy work."
>
  <div class="home-about" id="about">
    <p>
      I help turn AI into things people actually use. I’m a Strategic
      Solution Engineer at Microsoft. Before that, I built an online grocery
      experience and the organization behind it, helped bring robot delivery
      to Finland, and shipped web and mobile software for startups and large
      companies.
    </p>

    <p>
      I write here about AI, software, and how they change the way
      organizations work. You can reach me on
      <a href="https://www.linkedin.com/in/ragmha/">LinkedIn</a>.
    </p>
  </div>

  {latestPosts.length > 0 && (
    <section class="home-writing" aria-labelledby="latest-writing">
      <div class="section-head">
        <h2 id="latest-writing">Latest writing</h2>
        <a href="/writing/">All writing</a>
      </div>
      <PostList posts={latestPosts.map((post) => ({
        href: `/writing/${getPostSlug(post)}/`,
        date: formatDate(post.data.date),
        title: post.data.title,
        description: post.data.description,
      }))} />
    </section>
  )}
</SiteLayout>
