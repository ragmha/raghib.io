---
import SiteLayout from '../layouts/SiteLayout.astro'
import PostList from '../components/PostList.astro'
import { formatDate, getPostSlug, getPublishedPosts, groupPosts } from '../lib/posts'

const posts = await getPublishedPosts()
const latestPosts = posts.slice(0, 3)
const topics = groupPosts(posts, (post) => post.data.topics)
---

<SiteLayout
  title="Software, AI & Systems"
  description="Independent writing by Raghib Hasan on AI, software, and the systems that turn promising technology into useful, trustworthy work."
>
  <Fragment slot="heading">Tinkering with <s>AI</s> SI</Fragment>

  <div class="home-about" id="about">
    <p>
      I build software and start things. Here I write about turning AI into
      things people actually use.
    </p>

    <p>
      <a href="https://www.linkedin.com/in/ragmha/">LinkedIn</a> ·
      <a href="https://github.com/ragmha">GitHub</a>
    </p>
  </div>

  {topics.length > 0 && (
    <nav class="topic-strip" aria-label="Topics">
      <span>Gone deep on:</span>
      {topics.map(({ name, slug }) => (
        <a href={`/writing/topic/${slug}/`}>{name}</a>
      ))}
      <a href="/writing/topic/">All topics →</a>
    </nav>
  )}

  {latestPosts.length > 0 && (
    <section class="home-writing" aria-labelledby="latest-writing">
      <div class="section-head">
        <h2 id="latest-writing">Latest writing</h2>
        <a href="/writing/">All writing</a>
      </div>
      <PostList posts={latestPosts.map((post) => ({
        href: `/writing/${getPostSlug(post)}/`,
        date: formatDate(post.data.date),
        title: post.data.title,
      }))} />
    </section>
  )}
</SiteLayout>

<style>
  .topic-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0 0 2.5rem;
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .topic-strip span {
    color: var(--ink-faint);
  }
</style>
