---
import SiteLayout from '../layouts/SiteLayout.astro'
import PostList from '../components/PostList.astro'
import { formatDate, getPostSlug, getPublishedPosts } from '../lib/posts'

const latestPosts = (await getPublishedPosts()).slice(0, 3)
---

<SiteLayout
  title="Software, AI & Systems"
  heading="Ideas on technology and systems"
  description="Independent essays on software, AI, and systems by Raghib Hasan. Practical experiments, engineering trade-offs, and ideas that apply across industries."
>
  <div class="home-about" id="about">
    <p>
      I currently work at Microsoft as a Senior Software Solution
      Engineer, helping enterprises build and ship secure, AI-enabled
      software with GitHub.
    </p>

    <p>Previously occupied by:</p>
    <ul>
      <li>Scaling online grocery platforms and delivery experiences</li>
      <li>Validating AI and SaaS ideas through rapid prototyping</li>
      <li>Building and improving full-stack web and mobile applications</li>
    </ul>

    <p>
      You can reach me on <a href="https://www.linkedin.com/in/ragmha/">LinkedIn</a>.
    </p>
  </div>

  {latestPosts.length > 0 && (
    <section class="home-writing" aria-labelledby="latest-writing">
      <div class="section-head">
        <h2 id="latest-writing">Latest writing</h2>
        <a href="/writing/">All writing</a>
      </div>
      <PostList posts={latestPosts.map((post) => ({
        href: `/writing/${getPostSlug(post)}/`,
        date: formatDate(post.data.date),
        title: post.data.title,
        description: post.data.description,
      }))} />
    </section>
  )}
</SiteLayout>
