---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/home.css'
---

<BaseLayout
  description="Independent writing on software, AI, systems, and the ideas shaping how technology is built and used."
  bodyClass="home-surface"
  pageClass="home-page"
>
  <main class="home-matcha">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Raghib Hasan</h1>
      <p>Independent technology writing across software, AI, and systems.</p>

      <section class="home-about" id="about" aria-labelledby="about-title">
        <h2 id="about-title">About</h2>
        <p>
          I write about the ideas, trade-offs, and systems shaping modern
          technology.
        </p>

        <h3>What that means</h3>
        <p>
          My interest is not limited to a particular company, product, or
          industry. I explore how emerging technology becomes practical: how
          ideas survive contact with security, reliability, governance, human
          behavior, and the constraints of real organizations.
        </p>

        <h3>What I write about</h3>
        <ul>
          <li>AI-assisted work and the changing nature of software development</li>
          <li>Architecture, observability, and platform thinking</li>
          <li>AI governance, evaluation, and operational guardrails</li>
          <li>Developer experience, adoption, and organizational change</li>
        </ul>
      </section>
    </section>

    <nav class="home-nav" aria-label="Site sections">
      <a href="/writing">Writing</a>
      <a href="/projects">Projects</a>
      <a href="#about">About</a>
      <a href="/writing/feed.xml">RSS ↗</a>
      <a href="https://github.com/ragmha">GitHub ↗</a>
      <a href="https://www.linkedin.com/in/ragmha/">LinkedIn ↗</a>
      <span>raghib.io</span>
    </nav>
  </main>
</BaseLayout>
