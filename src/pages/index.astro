---
import BaseLayout from '../layouts/BaseLayout.astro'
import '../styles/home.css'
---

<BaseLayout
  description="Independent writing on software, AI, systems, and the ideas shaping how technology is built and used."
  bodyClass="home-surface"
  pageClass="home-page"
>
  <main class="home-matcha">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Raghib Hasan</h1>

      <div class="home-about" id="about">
        <p>
          I currently work at Microsoft in Finland as a Strategic Solutions
          Engineer, helping enterprises build and ship secure, AI-enabled
          software with GitHub.
        </p>

        <p>Previously occupied by:</p>
        <ul>
          <li>Scaling S-Group's online grocery platform</li>
          <li>Building an AI-powered SaaS product at Antler</li>
          <li>Shipping web, mobile, and IoT systems at Codemate</li>
        </ul>

        <p>
          You can reach me on <a href="https://www.linkedin.com/in/ragmha/">LinkedIn</a>.
        </p>

        <div class="home-socials">
          <a href="https://github.com/ragmha" aria-label="GitHub profile">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.86c-2.78.6-3.37-1.18-3.37-1.18-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.89 1.53 2.34 1.09 2.91.83.09-.65.35-1.09.64-1.34-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.99 1.03-2.69-.1-.25-.45-1.27.1-2.65 0 0 .84-.27 2.75 1.03A9.58 9.58 0 0 1 12 6.82c.85 0 1.71.11 2.51.34 1.91-1.3 2.75-1.03 2.75-1.03.55 1.38.2 2.4.1 2.65.64.7 1.03 1.6 1.03 2.69 0 3.84-2.34 4.69-4.58 4.94.36.31.68.92.68 1.85v2.75c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
            </svg>
          </a>
          <a href="https://www.linkedin.com/in/ragmha/" aria-label="LinkedIn profile">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14M8.5 9H6v9h2.5V9M7.25 5.5a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3M18 12.5c0-2.35-1.25-3.5-3-3.5-1.05 0-1.8.58-2.25 1.2V9H10.5v9H13v-5c0-1.11.45-1.75 1.4-1.75.9 0 1.1.65 1.1 1.75v5H18v-5.5Z" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <nav class="home-nav" aria-label="Site sections">
      <a href="/writing">Writing</a>
      <a href="/projects">Projects</a>
      <a href="#about">About</a>
      <a href="/writing/feed.xml">RSS ↗</a>
      <span>raghib.io</span>
    </nav>
  </main>
</BaseLayout>
