---
import BaseLayout from '../layouts/BaseLayout.astro'
import ThemeToggle from '../components/ThemeToggle.astro'
import '../styles/home.css'
---

<BaseLayout
  description="Independent writing on software, AI, systems, and the ideas shaping how technology is built and used."
  bodyClass="home-surface"
  pageClass="home-page"
  defaultTheme="dark"
>
  <header class="home-header">
    <a href="/">Raghib Hasan</a>
    <ThemeToggle />
  </header>

  <main class="home-matcha">
    <section class="home-intro" aria-labelledby="home-title">
      <h1 id="home-title">Ideas on technology and systems</h1>

      <div class="home-about" id="about">
        <p>
          I currently work at Microsoft as a Senior Software Solution
          Engineer, helping enterprises build and ship secure, AI-enabled
          software with GitHub.
        </p>

        <p>Previously occupied by:</p>
        <ul>
          <li>Scaling online grocery platforms and delivery experiences</li>
          <li>Validating AI and SaaS ideas through rapid prototyping</li>
          <li>Building and improving full-stack web and mobile applications</li>
        </ul>

        <p>
          You can reach me on <a href="https://www.linkedin.com/in/ragmha/">LinkedIn</a>.
        </p>
      </div>
    </section>

    <nav class="home-nav" aria-label="Site sections">
      <a href="/writing">Writing</a>
      <a href="/projects">Projects</a>
    </nav>
  </main>
</BaseLayout>
