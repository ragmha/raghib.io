---
import { buildDecisionFigure, decisionFigures } from '../lib/decision-anatomy.mjs'
import '../../scripts/vendor/anatomy/iso.css'
import '../styles/anatomy.css'

interface Props {
  variant: keyof typeof decisionFigures
}

const { variant } = Astro.props
const figure = decisionFigures[variant]
const { svg, parts } = buildDecisionFigure(variant)
const readoutId = `decision-${variant}-readout`
const keyId = `decision-${variant}-key`
---

<figure class="anatomy-figure iso" data-anatomy data-parts={parts}>
  <div class="anatomy-header">
    <span>Fig. {figure.number}</span>
    <span>{figure.title}</span>
  </div>
  <div class="anatomy-drawing" set:html={svg} />
  <div class="anatomy-explainer" id={keyId}>
    <h3>What the picture means</h3>
    <ol>
      {figure.key.map((item, index) => (
        <li data-key-step={index} data-selected={index === 0 ? '' : undefined}>{item}</li>
      ))}
    </ol>
  </div>
  <p class="anatomy-instruction">Select a step to highlight the matching part.</p>
  <div class="anatomy-controls" role="group" aria-label={`Highlight a part in ${figure.title}`} hidden>
    {figure.labels.map((label, index) => (
      <button
        type="button"
        data-step={index}
        data-detail={figure.details[index]}
        aria-pressed={index === 0 ? 'true' : 'false'}
        aria-controls={`${readoutId} ${keyId}`}
      >{label}</button>
    ))}
  </div>
  <p class="anatomy-readout" id={readoutId} aria-live="polite" aria-atomic="true">
    {figure.details[0]}
  </p>
  <figcaption>{figure.caption}</figcaption>
  <noscript>
    <ol>{figure.labels.map((label, index) => <li><strong>{label}:</strong> {figure.details[index]}</li>)}</ol>
  </noscript>
</figure>

<script>
  import '../scripts/decision-anatomy'
</script>
