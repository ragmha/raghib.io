---
const currentPath = Astro.url.pathname.replace(/\/$/, '')
---

<nav class="site-nav" aria-label="Site sections">
  <a href="/writing" aria-current={currentPath === '/writing' ? 'page' : undefined}>Writing</a>
  <a href="/projects" aria-current={currentPath === '/projects' ? 'page' : undefined}>Projects</a>
</nav>

<style>
  .site-nav {
    --nav-text: var(--site-text, var(--ink));
    --nav-bg: var(--site-bg, var(--paper));
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    align-self: start;
    gap: 0.75rem;
    color: var(--nav-text);
    font-size: 0.85rem;
    line-height: 2;
    letter-spacing: normal;
  }

  .site-nav a {
    padding-inline: 0.5rem;
    border: 0;
    background: transparent;
    color: inherit;
    text-decoration: none;
  }

  .site-nav a:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .site-nav a[aria-current='page'] {
    background: var(--nav-text);
    color: var(--nav-bg);
    font-weight: 600;
    text-decoration: none;
  }

  @media (max-width: 600px) {
    .site-nav {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.25rem 1rem;
    }
  }
</style>
