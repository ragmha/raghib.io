---
// Contents navigation for a single document's own section headings, sourced
// from Astro's heading extraction.
interface Props {
  headings: { slug: string; text: string; depth: number }[]
}

const { headings } = Astro.props
const parts = headings.filter((heading) => heading.depth >= 2 && heading.depth <= 4)
---

{
  parts.length > 0 && (
    <nav id="article-contents" class="parts" aria-label="Contents" data-contents-nav>
      <div class="parts-rail" aria-hidden="true">
        <span class="parts-window" data-reading-window></span>
      </div>
      <div class="parts-summary">
        <a class="parts-title" href="#post-title" data-part-link="post-title">On this page</a>
      </div>
      <ol>
        {parts.map((part) => (
          <li style={{ '--toc-depth': part.depth - 2 }}>
            <a href={`#${part.slug}`} data-part-link={part.slug}>
              <span class="part-title">{part.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </nav>
  )
}

<script src="../scripts/contents.js"></script>
