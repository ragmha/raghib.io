---
// Block labels for the post's topics and freeform tags. Colors are stable,
// but only appear on hover so the row stays quiet by default.
import { getTagColor, getTagLabel, getTaxonomySlug } from '../lib/posts'

interface Props {
  topics?: readonly string[]
  tags?: string[]
}

const { topics = [], tags = [] } = Astro.props
const labels = [
  ...topics.map((topic) => ({ label: topic, href: `/writing/topic/${getTaxonomySlug(topic)}/` })),
  ...tags.map((tag) => ({ label: getTagLabel(tag), href: `/writing/tag/${getTaxonomySlug(tag)}/` })),
]
---

{
  labels.length > 0 && (
    <ul class="tag-list">
      {labels.map(({ label, href }) => (
        <li class="tag" data-tag-color={getTagColor(label)}>
          <a class="tag-link" href={href}>{label}</a>
        </li>
      ))}
    </ul>
  )
}
