---
import ThemeToggle from './ThemeToggle.astro'

interface Props {
  contained?: boolean
}

const { contained = false } = Astro.props
---

<header class:list={['site-header', { 'site-header-contained': contained }]}>
  <a class="site-name" href="/">Raghib Hasan</a>
  <div class="header-controls">
    <ThemeToggle />
  </div>
</header>

<style>
  .site-header {
    --header-bg: var(--site-bg, var(--paper));
    --header-text: var(--site-text, var(--ink));
    --header-muted: var(--site-muted, var(--ink-muted));
    --header-rule: var(--line, var(--rule));
    position: sticky;
    top: 0;
    z-index: 5;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
    padding: 0.9rem clamp(1rem, 4vw, 2.5rem);
    background: color-mix(in srgb, var(--header-bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: none;
    color: var(--header-text);
    font-family: var(--font-mono);
    line-height: 1.75;
  }

  .site-name {
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: none;
    font-size: 0.78rem;
    border-bottom: none;
    text-decoration: none;
    background: transparent;
    color: inherit;
  }

  .site-header-contained {
    width: 100%;
    max-width: 960px;
    margin-inline: auto;
    padding: 3rem 1.25rem 0;
  }

  .header-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem;
    font-size: 0.7rem;
    letter-spacing: 0.14em;
  }

  .site-header :global(#theme-toggle) {
    font: inherit;
    letter-spacing: 0.14em;
    background: none;
    border: 1px solid var(--header-rule);
    border-radius: 0;
    color: var(--header-muted);
    padding: 0.25rem 0.6rem;
    cursor: pointer;
  }

  .site-header :global(#theme-toggle:hover) {
    background: var(--header-text);
    color: var(--header-bg);
    border-color: transparent;
  }

  @media print {
    .site-header {
      display: none;
    }
  }
</style>
