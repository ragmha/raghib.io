# Shared look for every clip. Record from the repo root:
#   for t in scripts/recordings/[0-9]*.tape; do vhs "$t"; done
# ponytail: Copilot output is non-deterministic; tune the Sleeps per clip and re-record.
Set Shell zsh
Set FontFamily "JetBrains Mono, Menlo, monospace"
Set FontSize 18
Set Width 1200
Set Height 640
Set Padding 24
Set TypingSpeed 60ms
Set Theme { "name": "raghib", "background": "#161614", "foreground": "#e7e5dc", "cursor": "#cede3f", "selection": "#2d2d28", "black": "#161614", "red": "#e06c5a", "green": "#cede3f", "yellow": "#e9c46a", "blue": "#7aa2c7", "magenta": "#c49bd1", "cyan": "#7fc4b8", "white": "#e7e5dc", "brightBlack": "#918e83", "brightRed": "#f08a78", "brightGreen": "#e9f56c", "brightYellow": "#f2d68a", "brightBlue": "#9cbde0", "brightMagenta": "#d8b6e3", "brightCyan": "#9fdccf", "brightWhite": "#ffffff" }
